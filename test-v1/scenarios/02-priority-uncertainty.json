{
  "protocol_version": 1,
  "id": "priority-uncertainty",
  "title": "Two unresolved comparisons preserve a strict provisional position",
  "kind": "end_to_end",
  "spec_refs": [
    "judgment",
    "selection"
  ],
  "clock": "2026-07-27T10:00:00Z",
  "parameter_overrides": {
    "priority_nearby_distance": 3,
    "priority_skip_limit": 2
  },
  "random_evidence": "priority-uncertainty-seed-001",
  "steps": [
    {
      "id": "create-a",
      "operation": "CreateRootBrick",
      "arguments": {
        "title": "Validate product A",
        "title_authority": "human",
        "behavior": "core/standard"
      },
      "bind_result": {
        "brick": "a"
      }
    },
    {
      "id": "create-b",
      "operation": "CreateRootBrick",
      "arguments": {
        "title": "Validate product B",
        "title_authority": "human",
        "behavior": "core/standard"
      },
      "bind_result": {
        "brick": "b",
        "insertion": "b_insertion"
      }
    },
    {
      "id": "answer-b",
      "operation": "AnswerPriorityComparison",
      "arguments": {
        "insertion": "$b_insertion",
        "answer": "no",
        "authority": "human"
      }
    },
    {
      "id": "create-c",
      "operation": "CreateRootBrick",
      "arguments": {
        "title": "Run customer interviews",
        "title_authority": "human",
        "behavior": "core/standard"
      },
      "bind_result": {
        "brick": "c",
        "insertion": "c_insertion"
      }
    },
    {
      "id": "first-skip",
      "operation": "SkipPriorityComparison",
      "arguments": {
        "insertion": "$c_insertion",
        "kind": "unresolved"
      }
    },
    {
      "id": "second-skip",
      "operation": "SkipPriorityComparison",
      "arguments": {
        "insertion": "$c_insertion",
        "kind": "unresolved"
      }
    }
  ],
  "assertions": [
    {
      "id": "first-skip-selects-nearby-distinct-candidate",
      "after": "first-skip",
      "query": "PriorityInsertion($c_insertion)",
      "path": "candidate_distance_from_previous",
      "operator": "between_inclusive",
      "value": [
        1,
        3
      ]
    },
    {
      "id": "skip-records-no-directional-judgment",
      "after": "second-skip",
      "query": "PriorityJudgmentsFor($c)",
      "path": "items",
      "operator": "count_equals",
      "value": 0
    },
    {
      "id": "skip-records-no-equality",
      "after": "second-skip",
      "query": "PriorityEvidenceFor($c)",
      "path": "contains_equality",
      "operator": "equals",
      "value": false
    },
    {
      "id": "insertion-defers-at-threshold",
      "after": "second-skip",
      "query": "PriorityInsertion($c_insertion)",
      "path": "status",
      "operator": "equals",
      "value": "deferred"
    },
    {
      "id": "brick-remains-strictly-positioned",
      "after": "second-skip",
      "query": "RootPriority",
      "path": "members",
      "operator": "contains_once",
      "value": "$c"
    },
    {
      "id": "position-is-marked-provisional",
      "after": "second-skip",
      "query": "PriorityViewItem($c)",
      "path": "provisional",
      "operator": "equals",
      "value": true
    },
    {
      "id": "uncertainty-creates-future-pressure",
      "after": "second-skip",
      "query": "OpenProposalsFor($c)",
      "path": "kinds",
      "operator": "contains",
      "value": "priority_probe"
    }
  ]
}
