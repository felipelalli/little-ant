{
  "protocol_version": 1,
  "id": "v0-v1-atomic-cutover",
  "title": "Verified semantic migration creates opaque IDs and activates atomically",
  "kind": "end_to_end",
  "spec_refs": [
    "migration-v0-v1",
    "domain",
    "judgment"
  ],
  "clock": "2026-07-27T20:00:00Z",
  "steps": [
    {
      "id": "plan-cutover",
      "operation": "PlanV0V1Cutover",
      "arguments": {
        "source_path": "fixtures/v0-v1-atomic-cutover.jsonl",
        "byte_size": 141,
        "event_count": 1,
        "sha256": "sha256:c132733bec3d288288ba18d3c9cbb8844ba8adeed0f0c79823242d673516439d"
      },
      "bind_result": {
        "archive": "archive",
        "cutover": "cutover"
      }
    },
    {
      "id": "verify-archive",
      "operation": "VerifyV0Archive",
      "arguments": {
        "cutover": "$cutover",
        "observed_hash": "sha256:c132733bec3d288288ba18d3c9cbb8844ba8adeed0f0c79823242d673516439d",
        "observed_event_count": 1
      }
    },
    {
      "id": "project-state",
      "operation": "ProjectV1State",
      "arguments": {
        "cutover": "$cutover",
        "projected_entity_count": 1,
        "retained_evidence_count": 1
      },
      "bind_result": {
        "v1_log_hash": "v1_log_hash"
      }
    },
    {
      "id": "map-seed",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:old-seed-title",
        "new_id": "la1:migration:entity:000000000002",
        "kind": "brick"
      }
    },
    {
      "id": "record-stage-evidence",
      "operation": "RecordMigrationEvidence",
      "arguments": {
        "cutover": "$cutover",
        "old_event_id": "event-17",
        "subject_old_id": "sha256:old-seed-title",
        "semantic_kind": "legacy_stage",
        "summary": "seed mapped to active provisionally positioned Brick"
      }
    },
    {
      "id": "verify-projection",
      "operation": "VerifyV1Projection",
      "arguments": {
        "cutover": "$cutover",
        "mapped_identity_count": 1,
        "projected_entity_count": 1,
        "v1_log_hash": "$v1_log_hash"
      }
    },
    {
      "id": "commit",
      "operation": "CommitV1Cutover",
      "arguments": {
        "cutover": "$cutover",
        "receipt_hash": "sha256:cutover-receipt"
      }
    }
  ],
  "assertions": [
    {
      "id": "planning-does-not-change-active-dataset",
      "after": "plan-cutover",
      "query": "ActiveDatasetPointer",
      "operator": "equals_snapshot",
      "value_from": "before:plan-cutover"
    },
    {
      "id": "archive-mismatch-fails-without-projection",
      "after": "plan-cutover",
      "operation": "VerifyV0Archive",
      "arguments": {
        "cutover": "$cutover",
        "observed_hash": "sha256:wrong",
        "observed_event_count": 1
      },
      "operator": "results_in",
      "value": {
        "status": "failed",
        "active_dataset_changed": false
      }
    },
    {
      "id": "legacy-title-derived-id-is-not-reused",
      "after": "map-seed",
      "query": "IdentityMap($archive,sha256:old-seed-title)",
      "path": "new_id",
      "operator": "not_equals",
      "value": "sha256:old-seed-title"
    },
    {
      "id": "legacy-stage-maps-to-active-positioned-brick",
      "after": "project-state",
      "query": "ProjectedBrick(sha256:old-seed-title)",
      "operator": "contains",
      "value": {
        "status": "active",
        "priority_membership_count": 1
      }
    },
    {
      "id": "verification-precedes-activation",
      "after": "verify-projection",
      "query": "ActiveDatasetPointer",
      "operator": "equals_snapshot",
      "value_from": "before:plan-cutover"
    },
    {
      "id": "commit-switches-to-clean-v1-log",
      "after": "commit",
      "query": "ActiveDataset",
      "operator": "contains",
      "value": {
        "format": "v1",
        "log_hash": "$v1_log_hash"
      }
    },
    {
      "id": "v0-archive-remains-byte-identical",
      "after": "commit",
      "query": "V0Archive($archive)",
      "operator": "contains",
      "value": {
        "sha256": "sha256:c132733bec3d288288ba18d3c9cbb8844ba8adeed0f0c79823242d673516439d",
        "immutable": true,
        "verified": true
      }
    },
    {
      "id": "committed-cutover-has-receipt",
      "after": "commit",
      "query": "V1Cutover($cutover)",
      "operator": "contains",
      "value": {
        "status": "committed",
        "receipt_hash": "sha256:cutover-receipt"
      }
    }
  ]
}
