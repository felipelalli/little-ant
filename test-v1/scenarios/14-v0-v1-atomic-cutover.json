{
  "protocol_version": 1,
  "id": "v0-v1-atomic-cutover",
  "title": "Verified semantic migration creates opaque IDs and activates atomically",
  "kind": "end_to_end",
  "spec_refs": [
    "migration-v0-v1",
    "domain",
    "judgment"
  ],
  "clock": "2026-07-27T20:00:00Z",
  "steps": [
    {
      "id": "plan-cutover",
      "operation": "PlanV0V1Cutover",
      "arguments": {
        "source_path": "fixtures/v0-v1-atomic-cutover.jsonl",
        "byte_size": 2125,
        "event_count": 11,
        "sha256": "sha256:38156acd5f5222ce93282f41695938ef0e8a2f1cf6f9f9893304555e69a62bb6"
      },
      "bind_result": {
        "archive": "archive",
        "cutover": "cutover"
      }
    },
    {
      "id": "verify-archive",
      "operation": "VerifyV0Archive",
      "arguments": {
        "cutover": "$cutover",
        "observed_hash": "sha256:38156acd5f5222ce93282f41695938ef0e8a2f1cf6f9f9893304555e69a62bb6",
        "observed_event_count": 11
      }
    },
    {
      "id": "project-state",
      "operation": "ProjectV1State",
      "arguments": {
        "cutover": "$cutover",
        "projected_entity_count": 8,
        "retained_evidence_count": 11
      },
      "bind_result": {
        "v1_log_hash": "v1_log_hash"
      }
    },
    {
      "id": "map-collision-a",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:synthetic-collision-a",
        "new_id": "la1:migration:entity:000000000002",
        "kind": "brick"
      }
    },
    {
      "id": "map-collision-b",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:synthetic-collision-b",
        "new_id": "la1:migration:entity:000000000003",
        "kind": "brick"
      }
    },
    {
      "id": "map-completed",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:synthetic-completed",
        "new_id": "la1:migration:entity:000000000004",
        "kind": "brick"
      }
    },
    {
      "id": "map-delegated",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:synthetic-delegated",
        "new_id": "la1:migration:entity:000000000005",
        "kind": "brick"
      }
    },
    {
      "id": "map-ordinary",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:synthetic-ordinary",
        "new_id": "la1:migration:entity:000000000006",
        "kind": "brick"
      }
    },
    {
      "id": "map-recurring",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:synthetic-recurring",
        "new_id": "la1:migration:entity:000000000007",
        "kind": "brick"
      }
    },
    {
      "id": "map-raw",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:synthetic-raw",
        "new_id": "la1:migration:entity:000000000008",
        "kind": "raw"
      }
    },
    {
      "id": "map-party",
      "operation": "RecordMigratedIdentity",
      "arguments": {
        "cutover": "$cutover",
        "old_id": "sha256:synthetic-delegate-party",
        "new_id": "la1:migration:entity:000000000009",
        "kind": "party"
      }
    },
    {
      "id": "record-stage-evidence",
      "operation": "RecordMigrationEvidence",
      "arguments": {
        "cutover": "$cutover",
        "old_event_id": "synthetic-event-ordinary",
        "subject_old_id": "sha256:synthetic-ordinary",
        "semantic_kind": "legacy_stage",
        "summary": "ordinary synthetic seed mapped to active provisionally positioned Brick"
      }
    },
    {
      "id": "verify-projection",
      "operation": "VerifyV1Projection",
      "arguments": {
        "cutover": "$cutover",
        "mapped_identity_count": 8,
        "projected_entity_count": 8,
        "v1_log_hash": "$v1_log_hash"
      }
    },
    {
      "id": "commit",
      "operation": "CommitV1Cutover",
      "arguments": {
        "cutover": "$cutover",
        "receipt_hash": "sha256:cutover-receipt"
      }
    }
  ],
  "assertions": [
    {
      "id": "planning-does-not-change-active-dataset",
      "after": "plan-cutover",
      "query": "ActiveDatasetPointer",
      "operator": "equals_snapshot",
      "value_from": "before:plan-cutover"
    },
    {
      "id": "archive-mismatch-fails-without-projection",
      "after": "plan-cutover",
      "operation": "VerifyV0Archive",
      "arguments": {
        "cutover": "$cutover",
        "observed_hash": "sha256:wrong",
        "observed_event_count": 1
      },
      "operator": "results_in",
      "value": {
        "status": "failed",
        "active_dataset_changed": false
      }
    },
    {
      "id": "legacy-title-derived-id-is-not-reused",
      "after": "map-ordinary",
      "query": "IdentityMap($archive,sha256:synthetic-ordinary)",
      "path": "new_id",
      "operator": "not_equals",
      "value": "sha256:synthetic-ordinary"
    },
    {
      "id": "legacy-stage-maps-to-active-positioned-brick",
      "after": "project-state",
      "query": "ProjectedBrick(sha256:synthetic-ordinary)",
      "operator": "contains",
      "value": {
        "status": "active",
        "priority_membership_count": 1
      }
    },
    {
      "id": "verification-precedes-activation",
      "after": "verify-projection",
      "query": "ActiveDatasetPointer",
      "operator": "equals_snapshot",
      "value_from": "before:plan-cutover"
    },
    {
      "id": "commit-switches-to-clean-v1-log",
      "after": "commit",
      "query": "ActiveDataset",
      "operator": "contains",
      "value": {
        "format": "v1",
        "log_hash": "$v1_log_hash"
      }
    },
    {
      "id": "v0-archive-remains-byte-identical",
      "after": "commit",
      "query": "V0Archive($archive)",
      "operator": "contains",
      "value": {
        "sha256": "sha256:38156acd5f5222ce93282f41695938ef0e8a2f1cf6f9f9893304555e69a62bb6",
        "immutable": true,
        "verified": true
      }
    },
    {
      "id": "committed-cutover-has-receipt",
      "after": "commit",
      "query": "V1Cutover($cutover)",
      "operator": "contains",
      "value": {
        "status": "committed",
        "receipt_hash": "sha256:cutover-receipt"
      }
    }
  ]
}
