{
  "protocol_version": 1,
  "id": "practice-streak-and-blocker",
  "title": "Practice streaks distinguish a miss from an inapplicable blocked window",
  "kind": "end_to_end",
  "spec_refs": [
    "domain",
    "execution",
    "selection"
  ],
  "clock": "2026-07-06T08:00:00-03:00",
  "parameter_overrides": {
    "practice_review_threshold": 3
  },
  "steps": [
    {
      "id": "create-swimming",
      "operation": "CreateFixture",
      "arguments": {
        "fixture": "template_brick",
        "template": "standard/exercise_practice@1",
        "title": "Swim twice per week"
      },
      "bind_result": {
        "brick": "swimming"
      }
    },
    {
      "id": "configure-practice",
      "operation": "ConfigureRecurrence",
      "arguments": {
        "target": "$swimming",
        "kind": "practice",
        "schedule": "2 times per ISO week",
        "timezone": "America/Montevideo",
        "first_release": "2026-07-06T00:00:00-03:00"
      },
      "bind_result": {
        "recurrence": "practice"
      }
    },
    {
      "id": "release-week-one",
      "operation": "AdvanceSchedules",
      "arguments": {
        "at": "2026-07-06T08:00:00-03:00"
      },
      "bind_result": {
        "opportunities": [
          "w1a",
          "w1b"
        ]
      }
    },
    {
      "id": "complete-w1a",
      "operation": "CompletePracticeOpportunity",
      "arguments": {
        "opportunity": "$w1a",
        "note": "Morning swim"
      }
    },
    {
      "id": "complete-w1b",
      "operation": "CompletePracticeOpportunity",
      "arguments": {
        "opportunity": "$w1b",
        "note": "Evening swim"
      }
    },
    {
      "id": "release-week-two",
      "operation": "AdvanceSchedules",
      "arguments": {
        "at": "2026-07-13T08:00:00-03:00"
      },
      "bind_result": {
        "opportunities": [
          "w2a",
          "w2b"
        ]
      }
    },
    {
      "id": "complete-w2a",
      "operation": "CompletePracticeOpportunity",
      "arguments": {
        "opportunity": "$w2a"
      }
    },
    {
      "id": "miss-w2b",
      "operation": "AbandonPracticeOpportunity",
      "arguments": {
        "opportunity": "$w2b",
        "reason": "Pool was too cold"
      }
    },
    {
      "id": "create-enabling-work",
      "operation": "CreateFixture",
      "arguments": {
        "fixture": "active_root_brick",
        "title": "Find a swimming pool"
      },
      "bind_result": {
        "brick": "find_pool"
      }
    },
    {
      "id": "block-practice",
      "operation": "AddDependency",
      "arguments": {
        "blocked": "$swimming",
        "blocker": "$find_pool"
      }
    },
    {
      "id": "release-blocked-week",
      "operation": "AdvanceSchedules",
      "arguments": {
        "at": "2026-07-20T08:00:00-03:00"
      },
      "bind_result": {
        "opportunities": [
          "w3a",
          "w3b"
        ]
      }
    }
  ],
  "assertions": [
    {
      "id": "direct-practice-completion-invents-no-start",
      "after": "complete-w1a",
      "query": "LatestExecution($swimming)",
      "path": "started_at",
      "operator": "is_null"
    },
    {
      "id": "miss-is-recorded-honestly",
      "after": "miss-w2b",
      "query": "PracticeOpportunity($w2b)",
      "operator": "contains",
      "value": {
        "status": "not_done",
        "reason": "Pool was too cold"
      }
    },
    {
      "id": "blocked-windows-are-not-applicable",
      "after": "release-blocked-week",
      "query": "PracticeOpportunities($practice,2026-W30)",
      "path": "items",
      "operator": "all_match",
      "value": {
        "status": "not_applicable"
      }
    },
    {
      "id": "inapplicable-window-does-not-add-failure",
      "after": "release-blocked-week",
      "query": "PracticeHistory($practice)",
      "path": "not_done_count",
      "operator": "equals",
      "value": 1
    },
    {
      "id": "history-renders-minigame-marks",
      "after": "release-blocked-week",
      "query": "PracticeHistory($practice)",
      "path": "marks",
      "operator": "equals",
      "value": [
        "x",
        "x",
        "x",
        "-",
        "n/a",
        "n/a"
      ]
    },
    {
      "id": "blocker-can-receive-unlock-pressure",
      "after": "block-practice",
      "query": "ForecastReasons($find_pool)",
      "path": "items",
      "operator": "contains",
      "value": "unlocks important practice"
    },
    {
      "id": "practice-priority-never-changes-implicitly",
      "after": "release-blocked-week",
      "query": "PriorityPath($swimming)",
      "operator": "equals_snapshot",
      "value_from": "before:configure-practice"
    }
  ]
}
