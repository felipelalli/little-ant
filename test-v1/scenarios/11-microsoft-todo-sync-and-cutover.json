{
  "protocol_version": 1,
  "id": "microsoft-todo-sync-and-cutover",
  "title": "Synchronization preserves local work while reviewed migration cleanup is item-scoped",
  "kind": "end_to_end",
  "spec_refs": [
    "integration",
    "material",
    "selection"
  ],
  "clock": "2026-07-27T17:00:00Z",
  "steps": [
    {
      "id": "create-sync-profile",
      "operation": "CreateImportProfile",
      "arguments": {
        "name": "Microsoft To Do inbox",
        "adapter": "standard/microsoft-todo@1",
        "source_scope": "account:felipe/list:inbox",
        "candidate_kind": "structured_task",
        "route": "adopt_brick",
        "automatic_adoption": true
      },
      "bind_result": {
        "profile": "profile"
      }
    },
    {
      "id": "plan-sync",
      "operation": "PlanImport",
      "arguments": {
        "profile": "$profile",
        "mode": "synchronize",
        "erase_after_import": false
      },
      "bind_result": {
        "run": "sync"
      }
    },
    {
      "id": "start-sync",
      "operation": "StartImport",
      "arguments": {
        "run": "$sync"
      }
    },
    {
      "id": "accept-task",
      "operation": "AcceptImportCandidate",
      "arguments": {
        "run": "$sync",
        "candidate": {
          "provider": "microsoft-todo",
          "account": "felipe",
          "external_id": "task-42",
          "container_id": "inbox",
          "kind": "structured_task",
          "original_title": "Comprar filtro",
          "canonical_english": "Buy a water filter",
          "normalization_authority": "adapter",
          "content_hash": "sha256:task-42-v1",
          "revision": "1",
          "presence": "present",
          "work_state": "open"
        }
      },
      "bind_result": {
        "record": "record",
        "raw": "raw",
        "brick": "brick"
      }
    },
    {
      "id": "observe-upstream-removal",
      "operation": "AcceptImportCandidate",
      "arguments": {
        "run": "$sync",
        "candidate": {
          "provider": "microsoft-todo",
          "account": "felipe",
          "external_id": "task-42",
          "container_id": "inbox",
          "kind": "structured_task",
          "original_title": "Comprar filtro",
          "canonical_english": "Buy a water filter",
          "normalization_authority": "adapter",
          "content_hash": "sha256:task-42-v2",
          "revision": "2",
          "presence": "removed",
          "work_state": "unknown"
        }
      }
    },
    {
      "id": "finish-sync",
      "operation": "FinishImportCapture",
      "arguments": {
        "run": "$sync"
      }
    },
    {
      "id": "verify-sync",
      "operation": "VerifyImport",
      "arguments": {
        "run": "$sync",
        "verified_count": 2,
        "failure_count": 0
      }
    },
    {
      "id": "complete-sync",
      "operation": "CompleteSynchronization",
      "arguments": {
        "run": "$sync",
        "receipt_hash": "sha256:sync-receipt"
      }
    },
    {
      "id": "plan-migration",
      "operation": "PlanImport",
      "arguments": {
        "profile": "$profile",
        "mode": "migrate",
        "erase_after_import": true
      },
      "bind_result": {
        "run": "migration"
      }
    },
    {
      "id": "prepare-verified-migration",
      "operation": "CreateFixture",
      "arguments": {
        "fixture": "verified_migration_from_existing_records",
        "run": "$migration",
        "reviewed_dispositions": true,
        "locally_reconstructible": true
      }
    },
    {
      "id": "plan-cleanup",
      "operation": "PlanEraseAfterImport",
      "arguments": {
        "run": "$migration"
      },
      "bind_result": {
        "item_effect": "erase_task"
      }
    },
    {
      "id": "approve-item-cleanup",
      "operation": "ApproveSourceEffect",
      "arguments": {
        "effect": "$erase_task"
      }
    },
    {
      "id": "record-cleanup-failure",
      "operation": "RecordSourceEffectFailed",
      "arguments": {
        "effect": "$erase_task",
        "failure": "HTTP 503"
      }
    },
    {
      "id": "retry-cleanup",
      "operation": "RetrySourceEffect",
      "arguments": {
        "effect": "$erase_task"
      }
    },
    {
      "id": "record-cleanup-success",
      "operation": "RecordSourceEffectApplied",
      "arguments": {
        "effect": "$erase_task",
        "receipt": "microsoft-request-id:abc"
      }
    },
    {
      "id": "cut-over",
      "operation": "CutOverImport",
      "arguments": {
        "run": "$migration",
        "receipt_hash": "sha256:migration-receipt"
      }
    }
  ],
  "assertions": [
    {
      "id": "automatic-adoption-preserves-raw-and-brick",
      "after": "accept-task",
      "query": "ExternalRecord($record)",
      "operator": "contains_references",
      "value": [
        "$raw",
        "$brick"
      ]
    },
    {
      "id": "imported-brick-is-positioned",
      "after": "accept-task",
      "query": "PriorityMemberships($brick)",
      "path": "count",
      "operator": "equals",
      "value": 1
    },
    {
      "id": "sync-removal-does-not-complete-local-brick",
      "after": "observe-upstream-removal",
      "query": "BrickSummary($brick)",
      "path": "status",
      "operator": "equals",
      "value": "active"
    },
    {
      "id": "sync-completion-keeps-profile-active",
      "after": "complete-sync",
      "query": "ImportProfile($profile)",
      "path": "status",
      "operator": "equals",
      "value": "active"
    },
    {
      "id": "erase-after-import-is-migration-only",
      "operation": "PlanImport",
      "arguments": {
        "profile": "$profile",
        "mode": "synchronize",
        "erase_after_import": true
      },
      "operator": "rejected_with",
      "value": "precondition_failed"
    },
    {
      "id": "cleanup-is-item-scoped-and-previewed",
      "after": "plan-cleanup",
      "query": "SourceEffect($erase_task)",
      "operator": "contains",
      "value": {
        "kind": "erase_object",
        "status": "proposed",
        "record": "$record"
      }
    },
    {
      "id": "failed-effect-remains-retryable",
      "after": "record-cleanup-failure",
      "query": "SourceEffect($erase_task)",
      "path": "status",
      "operator": "equals",
      "value": "failed"
    },
    {
      "id": "cutover-waits-for-resolved-cleanup",
      "operation": "CutOverImport",
      "at": "after:record-cleanup-failure",
      "arguments": {
        "run": "$migration",
        "receipt_hash": "too-early"
      },
      "operator": "rejected_with",
      "value": "precondition_failed"
    },
    {
      "id": "successful-cutover-retires-profile",
      "after": "cut-over",
      "query": "ImportProfile($profile)",
      "path": "status",
      "operator": "equals",
      "value": "retired"
    },
    {
      "id": "container-deletion-is-not-implied",
      "after": "cut-over",
      "query": "SourceEffects($migration)",
      "path": "kinds",
      "operator": "not_contains",
      "value": "erase_container"
    }
  ]
}
