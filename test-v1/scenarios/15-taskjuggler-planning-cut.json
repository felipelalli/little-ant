{
  "protocol_version": 1,
  "id": "taskjuggler-planning-cut",
  "title": "TaskJuggler export avoids double counting and keeps actuals separate",
  "kind": "end_to_end",
  "spec_refs": [
    "judgment",
    "integration"
  ],
  "clock": "2026-07-27T21:00:00Z",
  "steps": [
    {
      "id": "create-planning-tree",
      "operation": "CreateFixture",
      "arguments": {
        "fixture": "estimated_project",
        "project": "Release Little Ant 1.0",
        "children": [
          {
            "title": "Implement event store",
            "effort_band": "HARD"
          },
          {
            "title": "Implement REPL",
            "effort_band": "MODERATED"
          }
        ],
        "effort_profile": "core/effort@1"
      },
      "bind_result": {
        "project": "project",
        "event_store": "event_store",
        "repl": "repl",
        "effort_profile": "profile"
      }
    },
    {
      "id": "export-valid-cut",
      "operation": "ExportTaskJuggler",
      "arguments": {
        "dataset_revision": "$current_domain_revision",
        "selected_bricks": [
          "$event_store",
          "$repl"
        ],
        "effort_profile": "$profile",
        "payload": {
          "media_type": "text/x-taskjuggler",
          "suggested_filename": "little-ant-1.0.tjp",
          "content_hash": "sha256:tjp",
          "size": 4096
        }
      },
      "bind_result": {
        "manifest": "manifest"
      }
    },
    {
      "id": "import-event-store-actual",
      "operation": "ImportTaskJugglerActual",
      "arguments": {
        "manifest": "$manifest",
        "brick": "$event_store",
        "observed_hours": 51.5
      },
      "bind_result": {
        "actual": "actual"
      }
    }
  ],
  "assertions": [
    {
      "id": "ancestor-descendant-cut-is-rejected",
      "operation": "ExportTaskJuggler",
      "arguments": {
        "dataset_revision": "$current_domain_revision",
        "selected_bricks": [
          "$project",
          "$event_store"
        ],
        "effort_profile": "$profile",
        "payload": {
          "media_type": "text/x-taskjuggler",
          "suggested_filename": "invalid.tjp",
          "content_hash": "sha256:invalid",
          "size": 1
        }
      },
      "operator": "rejected_with",
      "value": "precondition_failed"
    },
    {
      "id": "valid-manifest-pins-dataset-revision",
      "after": "export-valid-cut",
      "query": "PlanningManifest($manifest)",
      "path": "dataset_revision",
      "operator": "equals_reference",
      "value": "$current_domain_revision_at:export-valid-cut"
    },
    {
      "id": "manifest-pins-effort-profile",
      "after": "export-valid-cut",
      "query": "PlanningManifest($manifest)",
      "path": "effort_profile.id",
      "operator": "equals_reference",
      "value": "$profile"
    },
    {
      "id": "export-uses-profile-macros",
      "after": "export-valid-cut",
      "query": "ExportedTaskJuggler($manifest)",
      "operator": "contains_all",
      "value": [
        "EFFORT_4D",
        "EFFORT_2D"
      ]
    },
    {
      "id": "actual-is-separate-evidence",
      "after": "import-event-store-actual",
      "query": "ImportedActual($actual)",
      "operator": "contains",
      "value": {
        "brick": "$event_store",
        "observed_hours": 51.5
      }
    },
    {
      "id": "actual-does-not-rewrite-effort-band",
      "after": "import-event-store-actual",
      "query": "EffortEvidence($event_store)",
      "path": "current.band.id",
      "operator": "equals",
      "value": "HARD"
    },
    {
      "id": "actual-does-not-mutate-manifest",
      "after": "import-event-store-actual",
      "query": "PlanningManifest($manifest)",
      "operator": "equals_snapshot",
      "value_from": "after:export-valid-cut"
    }
  ]
}
