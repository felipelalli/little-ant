{
  "protocol_version": 1,
  "id": "served-skip-cooldown-and-pressure",
  "title": "A served skip cools work temporarily and retains long-term pressure",
  "kind": "simulation",
  "spec_refs": [
    "execution",
    "selection",
    "judgment"
  ],
  "clock": "2026-07-27T13:00:00Z",
  "parameter_overrides": {
    "served_skip_cooldown": "PT2H"
  },
  "steps": [
    {
      "id": "create-work",
      "operation": "CreateFixture",
      "arguments": {
        "fixture": "two_eligible_root_bricks",
        "titles": [
          "Prepare tax documents",
          "Tidy downloads folder"
        ]
      },
      "bind_result": {
        "scope": "scope",
        "Prepare tax documents": "taxes",
        "Tidy downloads folder": "tidy"
      }
    },
    {
      "id": "skip-once",
      "operation": "SkipServedBrick",
      "arguments": {
        "brick": "$taxes",
        "reason": "vague",
        "raw_text": "I need to find the statements first"
      }
    },
    {
      "id": "forecast-during-cooldown",
      "operation": "BuildForecast",
      "arguments": {
        "at": "2026-07-27T13:30:00Z",
        "domain_revision": "$current_domain_revision"
      },
      "bind": "cooldown_forecast"
    },
    {
      "id": "forecast-after-cooldown",
      "operation": "BuildForecast",
      "arguments": {
        "at": "2026-07-27T15:01:00Z",
        "domain_revision": "$current_domain_revision"
      },
      "bind": "later_forecast"
    },
    {
      "id": "skip-again",
      "operation": "SkipServedBrick",
      "arguments": {
        "brick": "$taxes",
        "at": "2026-07-27T15:01:00Z",
        "reason": "vague",
        "raw_text": "Still missing one bank statement"
      }
    }
  ],
  "assertions": [
    {
      "id": "skip-is-not-completion",
      "after": "skip-once",
      "query": "BrickSummary($taxes)",
      "path": "status",
      "operator": "equals",
      "value": "active"
    },
    {
      "id": "first-skip-creates-cooldown",
      "after": "skip-once",
      "query": "SelectionCooldown($taxes)",
      "path": "until",
      "operator": "equals",
      "value": "2026-07-27T15:00:00Z"
    },
    {
      "id": "cooldown-reduces-immediate-selection",
      "after": "forecast-during-cooldown",
      "query": "ForecastItem($cooldown_forecast,$taxes)",
      "path": "probability",
      "operator": "less_than",
      "value_from": "forecast:before-skip:$taxes.probability"
    },
    {
      "id": "work-returns-after-cooldown",
      "after": "forecast-after-cooldown",
      "query": "ForecastItem($later_forecast,$taxes)",
      "path": "probability",
      "operator": "greater_than",
      "value": 0.0
    },
    {
      "id": "repeat-skip-count-is-retained",
      "after": "skip-again",
      "query": "SelectionCooldown($taxes)",
      "path": "recent_skip_count",
      "operator": "equals",
      "value": 2
    },
    {
      "id": "repeat-skip-refreshes-cooldown",
      "after": "skip-again",
      "query": "SelectionCooldown($taxes)",
      "path": "until",
      "operator": "equals",
      "value": "2026-07-27T17:01:00Z"
    },
    {
      "id": "skip-never-reorders-priority",
      "after": "skip-again",
      "query": "PriorityScope($scope)",
      "path": "members",
      "operator": "equals_snapshot",
      "value_from": "before:skip-once"
    }
  ]
}
