{
  "protocol_version": 1,
  "id": "pack-sandbox-and-credentials",
  "title": "Pack execution is capability-bounded and a locked vault performs no HTTP",
  "kind": "end_to_end",
  "spec_refs": [
    "integration",
    "interaction"
  ],
  "clock": "2026-07-27T22:00:00Z",
  "steps": [
    {
      "id": "install-pack",
      "operation": "InstallPack",
      "arguments": {
        "manifest": {
          "id": "community/example",
          "version": 1,
          "publisher": "Example",
          "content_hash": "sha256:pack",
          "components": [
            {
              "id": "example/source",
              "version": 1,
              "kind": "source_adapter",
              "executable": true,
              "capabilities": [
                "http:api.example.com",
                "credential:example"
              ]
            }
          ]
        }
      },
      "bind_result": {
        "pack": "pack",
        "component": "component"
      }
    },
    {
      "id": "bind-credential",
      "operation": "CreateFixture",
      "arguments": {
        "fixture": "credential_binding",
        "component": "$component",
        "slot": "api-token",
        "account": "felipe"
      },
      "bind_result": {
        "binding": "binding"
      }
    },
    {
      "id": "lock-binding",
      "operation": "LockCredentialBinding",
      "arguments": {
        "binding": "$binding"
      }
    },
    {
      "id": "attempt-locked-request",
      "operation": "PackRunner.execute",
      "arguments": {
        "request": {
          "protocol_version": 1,
          "component_id": "example/source",
          "operation": "discover",
          "input": {
            "account": "felipe"
          },
          "capability_grants": [
            "http:api.example.com",
            "credential:example"
          ]
        }
      },
      "bind": "locked_result"
    },
    {
      "id": "replay-events",
      "operation": "CanonicalEventStore.replay",
      "arguments": {
        "through_revision": "$current_domain_revision"
      }
    }
  ],
  "assertions": [
    {
      "id": "undeclared-capability-is-rejected",
      "operation": "RecordPackInvocation",
      "arguments": {
        "component": "$component",
        "operation": "discover",
        "input_revision": "1",
        "request_hash": "sha256:req",
        "capability_grants": [
          "http:evil.example"
        ],
        "result": {
          "protocol_version": 1,
          "ok": true,
          "diagnostics": []
        }
      },
      "operator": "rejected_with",
      "value": "precondition_failed"
    },
    {
      "id": "locked-vault-has-distinct-error",
      "after": "attempt-locked-request",
      "query": "PackExecutionResult($locked_result)",
      "path": "error_code",
      "operator": "equals",
      "value": "credential_locked"
    },
    {
      "id": "locked-vault-performs-no-http",
      "after": "attempt-locked-request",
      "query": "HostHttpTrace",
      "path": "requests",
      "operator": "count_equals",
      "value": 0
    },
    {
      "id": "locked-vault-does-not-advance-provider-backoff",
      "after": "attempt-locked-request",
      "query": "ProviderBackoff(example/source,felipe)",
      "operator": "equals_snapshot",
      "value_from": "before:attempt-locked-request"
    },
    {
      "id": "lua-never-receives-secret",
      "operation": "InspectPackRuntimeInput",
      "query": "PackInvocationInput($component)",
      "operator": "omits",
      "value": [
        "secret",
        "token",
        "vault_payload"
      ]
    },
    {
      "id": "pack-runtime-has-no-raw-os",
      "operation": "ProbePackSandbox",
      "arguments": {
        "component": "$component"
      },
      "operator": "equals",
      "value": {
        "os": false,
        "process": false,
        "filesystem": false,
        "socket": false,
        "dynamic_library": false
      }
    },
    {
      "id": "replay-invokes-no-pack-code",
      "after": "replay-events",
      "query": "PackInvocationTrace",
      "path": "during_replay",
      "operator": "count_equals",
      "value": 0
    }
  ]
}
