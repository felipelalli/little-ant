-- allium: 3
-- Little Ant 1.0 — authoritative behavioural specification root.
--
-- Conceptual Markdown records are design history; this composed Allium model
-- is the normative product behaviour.

use "./little-ant/domain.allium" as domain
use "./little-ant/material.allium" as material
use "./little-ant/judgment.allium" as judgment
use "./little-ant/execution.allium" as execution
use "./little-ant/selection.allium" as selection
use "./little-ant/interaction.allium" as interaction
use "./little-ant/integration.allium" as integration
use "./little-ant/migration-v0-v1.allium" as migration

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneCanonicalBrickModel {
    -- Grocery lists, practices, projects, backlogs, repeatable reading, and
    -- recurring obligations use one Brick entity plus validated behavior
    -- capabilities. No provider or domain template creates a hard-coded Brick
    -- subtype.
    true
}

invariant RawIsMaterialAndBrickIsWork {
    -- Raw, RawSnapshot, and RawShelf never receive human-priority position,
    -- focus, WIP, done, or direct next-selection semantics. ListEntry remains
    -- a lightweight occurrence owned by a Brick rather than either Raw or
    -- independently focusable work.
    true
}

invariant GloballyOpaqueEntityIds {
    for brick in domain/Bricks:
        for raw in material/Raws:
            brick.id != raw.id
    for brick in domain/Bricks:
        for party in domain/Parties:
            brick.id != party.id
    for raw in material/Raws:
        for party in domain/Parties:
            raw.id != party.id
}

invariant EveryActiveBrickHasOneStrictSiblingPosition {
    for brick in domain/Bricks:
        brick.status = active implies
            judgment/PriorityScopes.any(
                scope => brick in scope.members
            )
}

invariant PriorityIsImportanceOnly {
    -- PriorityScope.members expresses the user's current strict importance
    -- order among siblings. Impact, urgency, effort, phase, readiness,
    -- dependency, forecast probability, and source order are never aliases
    -- for that judgment and never rewrite it implicitly.
    true
}

invariant ForecastIsNotAnotherStoredOrder {
    -- ForecastView is read-only. NextDraw persists only the selected outcome,
    -- reasons, domain revision, and replay-safe random evidence.
    true
}

invariant OptionalAxesStayLazy {
    -- Missing phase, impact, effort, mode, context, or description never turns
    -- capture into a mandatory form and never blocks ordinary active work by
    -- itself.
    true
}

invariant CoreMechanismAndExternalJudgmentAreSeparated {
    -- The core owns identity, validation, ordering mechanics, recurrence,
    -- eligibility, evidence history, revisions, and replay. Humans, the skill,
    -- powered-up mode, and typed adapters may propose semantic judgments but
    -- cannot bypass canonical operations.
    true
}

invariant CanonicalEnglishWithVerbatimProvenance {
    -- Product vocabulary and canonical searchable titles are English.
    -- Original input and Raw bytes remain verbatim and attributed.
    true
}

invariant NoGenericPluginAuthority {
    -- Little Ant Pack is the only extension distribution unit. Its closed
    -- component kinds grant typed bounded capabilities, never arbitrary hooks
    -- or replay-time execution.
    true
}

invariant LegacyBehaviorIsNotSpecAuthority {
    -- A behaviour implemented by v0 but absent here is not retained for
    -- compatibility. v1 has one canonical vocabulary and no core aliases.
    true
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Initial numeric calibration for confidence, aging, cooldown, forecast pressure, and validation frequency remains versioned inspectable policy."
open question "Exact shortcuts, glyphs, terminal layout, and response byte budgets remain presentation policy constrained by InteractionProtocol."
open question "Provider APIs, HTTP retry details, cryptographic construction, runner resource limits, and storage layout remain implementation choices constrained by typed contracts."
open question "Multi-device event transport is a post-1.0 concern and must not weaken local 1.0 determinism."
