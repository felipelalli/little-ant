-- allium: 3
-- Little Ant — behavioural specification.
-- Storage (event log, snapshots, archives), identity hashing, rendering and
-- transport are implementation concerns documented in README.md. This module
-- captures observable behaviour only.

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value SourceSnapshot {
    fingerprint: String
    fetched_at: Timestamp
}

value WriteBackReceipt {
    applied_at: Timestamp
    note: String?
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract SourceReader {
    fetch: (ref: String) -> SourceSnapshot

    @invariant NonDestructiveRead
        -- Fetching a source never mutates the source.

    @guidance
        -- Implemented by the operator (agent skill) using the integrations
        -- declared in the user's personal manifest. The core never talks to
        -- external systems itself.
}

contract WriteBackExecutor {
    apply: (effect: FollowUpEffect) -> WriteBackReceipt

    @invariant HumanApprovedOnly
        -- apply is only ever invoked for effects a human explicitly
        -- approved, and the full outbound content was shown before approval.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Kind { spec | exec | delegation | decision | meta }
enum Mode { digital | physical }
enum Atomicity { atomic | divisible | unknown }
enum Author { human | ai }
enum SkipReason { hard | vague | not_priority | waiting | tired | meh | kill | alternatives | other }
enum Strictness { ignore | prefer | require }
enum EffectKind { write_back | notify | spawn }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Party {
    name: String
    party_type: person | ai_agent | company | area
}

entity Brick {
    title: String
    description: String?
        -- Optional longer body. Content, not identity: describing a brick
        -- never changes which brick it is. Arrives lazily (e.g. when a
        -- skip(vague) clarification lands its "done criteria").
    stage: seed | committed | ready | wip | done | dropped | superseded
    atomicity: Atomicity
    kind: Kind?
    context: String?
    energy: Decimal?
    mode: Mode?
    parent: Brick?
    about: Brick?
    requester: Party?
    estimate_hours: Decimal?
    estimate_author: Author?
    wip_started_at: Timestamp?
    wip_flagged: Boolean?
    superseded_by: Brick when stage = superseded
    supersede_reason: String? when stage = superseded

    transitions stage {
        seed -> committed
        seed -> dropped
        committed -> ready
        committed -> dropped
        committed -> superseded
        ready -> wip
        ready -> committed
        ready -> done
        ready -> dropped
        ready -> superseded
        wip -> ready
        wip -> done
        wip -> dropped
        wip -> superseded
        terminal: done, dropped, superseded
    }

    -- Relationships
    children: Brick with parent = this
    skips: Skip with brick = this
    waits: Wait with brick = this
    sources: SourceLink with brick = this
    completion_effects: FollowUpEffect with brick = this
    blockers: Dependency with blocked = this
    dependents: Dependency with blocker = this
    comparisons_before: Comparison with before = this
    comparisons_after: Comparison with after = this

    -- Projections
    open_children: children where stage in {seed, committed, ready, wip}
    open_waits: waits where resolved = false

    -- Derived
    is_leaf: open_children.count = 0
    is_waiting: open_waits.count > 0
    is_blocked: blockers.any(d => d.blocker.stage in {seed, committed, ready, wip})
    is_servable: stage = ready and is_leaf and not is_waiting and not is_blocked

    invariant EnergyWithinUnitInterval {
        energy = null or (energy >= 0.0 and energy <= 1.0)
    }

    invariant EstimatePositive {
        estimate_hours = null or estimate_hours > 0.0
    }
}

entity RawInput {
    content: String
    received_at: Timestamp
    status: pending | extracted

    transitions status {
        pending -> extracted
        terminal: extracted
    }
}

entity Skip {
    brick: Brick
    reason: SkipReason
    raw_text: String?
    recorded_at: Timestamp

    invariant OtherCarriesRawText {
        reason = other implies raw_text != null
    }
}

entity Wait {
    brick: Brick
    on_party: Party?
    condition_note: String?
    resolved: Boolean
}

entity Dependency {
    blocked: Brick
    blocker: Brick
}

entity Comparison {
    before: Brick
    after: Brick
    author: Author
    recorded_at: Timestamp
    revalidation_requested: Boolean
}

entity SourceLink {
    brick: Brick
    type: String
        -- Free vocabulary: github_issue, file, chat, frill, url, …
        -- The core never rejects an unknown type.
    url: String
    last_fingerprint: String?
    diverged: Boolean
}

entity FollowUpEffect {
    brick: Brick
    kind: EffectKind
    detail: String
    status: armed | proposed | applied | declined

    transitions status {
        armed -> proposed
        armed -> applied
        proposed -> applied
        proposed -> declined
        terminal: applied, declined
    }
}

entity Delegation {
    brick: Brick
    delegate: Party
    status: to_notify | notified | nudged | completed | refused | abandoned
    nudge_count: Integer
    next_nudge_at: Timestamp?
    nudge_pending: Boolean

    transitions status {
        to_notify -> notified
        to_notify -> abandoned
        notified -> nudged
        notified -> completed
        notified -> refused
        notified -> abandoned
        nudged -> completed
        nudged -> refused
        nudged -> abandoned
        terminal: completed, refused, abandoned
    }
}

entity FocusSession {
    context_hint: String?
    strictness: Strictness
    serve_count: Integer
    status: open | closed

    transitions status {
        open -> closed
        terminal: closed
    }
}

entity TaxonomyWatch {
    unreviewed_other_count: Integer
    review_threshold: Integer

    review_due: unreviewed_other_count >= review_threshold
}

entity OrderWatch {
    bricks_readied_since_round: Integer
    round_threshold: Integer
    clock_at: Timestamp?
    open_round: Brick?

    round_due: bricks_readied_since_round >= round_threshold
    no_open_round: open_round = null or open_round.stage in {done, dropped, superseded}
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    background_serve_ratio: Integer = 5
    context_quantum: Duration = 2.hours
    comparison_shelf_life: Duration = 30.days
    nudge_interval: Duration = 3.days
    wip_check_after: Duration = 24.hours
    order_sanity_interval: Duration = 14.days
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

default TaxonomyWatch taxonomy = { unreviewed_other_count: 0, review_threshold: 5 }

default OrderWatch order_watch = { bricks_readied_since_round: 0, round_threshold: 7 }

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Capture and triage ----------------------------------------

rule SeedCaptured {
    when: CaptureSeed(title)
    ensures: Brick.created(title: title, stage: seed, atomicity: unknown)
}

rule RawInputCaptured {
    when: CaptureRawInput(content)
    ensures: RawInput.created(content: content, received_at: now, status: pending)
}

rule SeedsExtracted {
    when: ExtractRawInput(raw, seed_titles)
    requires: raw.status = pending
    ensures:
        raw.status = extracted
        for title in seed_titles:
            Brick.created(title: title, stage: seed, atomicity: unknown)

    @guidance
        -- Extraction may yield zero seeds: an empty seed_titles list simply
        -- marks the raw input as processed.
}

rule SeedPromoted {
    when: PromoteSeed(brick)
    requires: brick.stage = seed
    ensures: brick.stage = committed
}

rule BrickKilled {
    when: KillBrick(brick)
    requires: brick.stage in {seed, committed, ready, wip}
    ensures:
        brick.stage = dropped
        brick.wip_started_at = null
        brick.wip_flagged = null
}

rule BrickMarkedReady {
    when: MarkReady(brick)
    requires: brick.stage = committed
    ensures: brick.stage = ready

    @guidance
        -- The definition of ready (which metadata must exist per kind) is an
        -- open question; the operator prepares bricks approaching the top of
        -- the order via drip meta-work, never as a form at serve time.
}

rule RequesterAttributed {
    when: AttributeRequest(brick, party)
    ensures: brick.requester = party
}

rule BrickEnriched {
    when: EnrichBrick(brick, kind?, context?, energy?, mode?, atomicity?, estimate_hours?, estimate_author?)
    requires: brick.stage in {seed, committed, ready, wip}
    requires: energy = null or (energy >= 0.0 and energy <= 1.0)
    requires: estimate_hours = null or estimate_hours > 0.0
    ensures:
        if kind != null:
            brick.kind = kind
        if context != null:
            brick.context = context
        if energy != null:
            brick.energy = energy
        if mode != null:
            brick.mode = mode
        if atomicity != null:
            brick.atomicity = atomicity
        if estimate_hours != null:
            brick.estimate_hours = estimate_hours
            brick.estimate_author = estimate_author

    @guidance
        -- Lazy classification: enrichment happens in drips, at the moments
        -- the metadata is about to be used (triage, skip, approaching the
        -- top of the order) — never as a form at capture or serve time.
}

rule BrickDescribed {
    when: DescribeBrick(brick, description)
    requires: brick.stage in {seed, committed, ready, wip}
    requires: description != ""
    ensures: brick.description = description

    @guidance
        -- The description is content, not identity: it never changes which
        -- brick this is. Capture still takes a title and nothing else; the
        -- body arrives later — typically when a skip(vague) clarification
        -- produces "done criteria", or when the operator drafts context for
        -- a brick born inside the system (no external source to point at).
}

-- Composition ------------------------------------------------

rule BrickBroken {
    when: BreakBrick(brick, part_titles)
    requires: brick.atomicity != atomic
    requires: brick.stage in {committed, ready, wip}
    ensures:
        for title in part_titles:
            Brick.created(title: title, stage: committed, atomicity: unknown,
                parent: brick, kind: brick.kind, context: brick.context)

    @guidance
        -- Lazy decomposition: bricks are broken when they approach execution,
        -- not before. A parent with open children stops being servable
        -- (is_leaf becomes false); its rank derives from its best leaf.
}

rule BricksUnified {
    when: UnifyBricks(brick, into, reason?)
    requires: brick != into
    requires: brick.stage in {committed, ready}
    requires: into.stage in {seed, committed, ready, wip}
    ensures:
        for c in brick.comparisons_before where after != into:
            c.before = into
        for c in brick.comparisons_before where after = into:
            not exists c
        for c in brick.comparisons_after where before != into:
            c.after = into
        for c in brick.comparisons_after where before = into:
            not exists c
        brick.stage = superseded
        brick.superseded_by = into
        brick.supersede_reason = reason
}

rule BrickSuperseded {
    when: SupersedeBrick(brick, replacement_title, reason?)
    requires: brick.stage in {committed, ready, wip}
    ensures:
        let replacement = Brick.created(title: replacement_title,
            stage: committed, atomicity: unknown, parent: brick.parent,
            kind: brick.kind, context: brick.context, requester: brick.requester)
        for s in brick.sources:
            SourceLink.created(brick: replacement, type: s.type, url: s.url,
                last_fingerprint: s.last_fingerprint, diverged: s.diverged)
        for d in brick.blockers:
            Dependency.created(blocked: replacement, blocker: d.blocker)
        for d in brick.dependents:
            d.blocker = replacement
        for c in brick.comparisons_before:
            c.before = replacement
        for c in brick.comparisons_after:
            c.after = replacement
        brick.stage = superseded
        brick.superseded_by = replacement
        brick.supersede_reason = reason
        brick.wip_started_at = null
        brick.wip_flagged = null

    @guidance
        -- Supersede keeps the goal and replaces the method. The replacement
        -- inherits lineage, sources, dependencies and — by inheriting the
        -- predecessor's comparisons — its slot in the total order. The
        -- superseded state is deliberately neither done nor dropped, so
        -- statistics stay honest.
}

-- Focus loop -------------------------------------------------

rule SessionOpened {
    when: OpenSession(context_hint?, strictness)
    ensures: FocusSession.created(context_hint: context_hint,
        strictness: strictness, serve_count: 0, status: open)
}

rule SessionClosed {
    when: CloseSession(session)
    requires: session.status = open
    ensures: session.status = closed
}

rule FocusServed {
    when: RequestNext(session)
    requires: session.status = open
    ensures:
        session.serve_count = session.serve_count + 1
        FocusProposed(session: session, brick: select_next(session))

    @guidance
        -- select_next picks from servable bricks (is_servable) using the
        -- core mechanisms: two queues with config.background_serve_ratio
        -- (every Nth serve comes from the background queue), anti-starvation
        -- aging, and sticky context (session.context_hint honoured per
        -- session.strictness, within config.context_quantum). Policy — which
        -- context today, when to override the ratio — belongs to the
        -- operator, not the core.
}

rule BrickStarted {
    when: StartBrick(brick)
    requires: brick.stage = ready
    ensures:
        brick.stage = wip
        brick.wip_started_at = now
        brick.wip_flagged = false
}

rule BrickStopped {
    when: StopBrick(brick)
    requires: brick.stage = wip
    ensures:
        brick.stage = ready
        brick.wip_started_at = null
        brick.wip_flagged = null
}

rule BrickCompleted {
    when: CompleteBrick(brick)
    requires: brick.stage in {ready, wip}
    ensures:
        brick.stage = done
        brick.wip_started_at = null
        brick.wip_flagged = null
}

rule DanglingWipDetected {
    when: brick: Brick.wip_started_at + config.wip_check_after <= now
    requires: brick.stage = wip
    requires: brick.wip_flagged = false
    ensures:
        brick.wip_flagged = true
        DanglingWipFound(brick: brick)

    @guidance
        -- The operator asks "are you still on this?" — continue, stop
        -- retroactively, complete, or treat as a disguised skip.
}

-- Skip flow --------------------------------------------------

rule SkipTaken {
    when: SkipBrick(brick, reason, raw_text?)
    requires: brick.stage = ready
    ensures:
        Skip.created(brick: brick, reason: reason,
            raw_text: raw_text, recorded_at: now)

    @guidance
        -- The raw utterance is always preserved, classified or not. Free text
        -- is classified by the operator into a canonical reason (confirming
        -- with the human); when nothing fits, reason is other.
}

rule HardSkipOffersDecomposition {
    when: skip: Skip.created
    requires: skip.reason = hard
    ensures: DecompositionOffered(brick: skip.brick)

    @guidance
        -- Hard gets broken. If the brick is atomic, offer a learning brick
        -- or delegation instead of a break.
}

rule VagueSkipRegressesBrick {
    when: skip: Skip.created
    requires: skip.reason = vague
    requires: skip.brick.stage = ready
    ensures:
        skip.brick.stage = committed
        ClarificationOffered(brick: skip.brick)

    @guidance
        -- Vague gets specified, not broken. The brick regresses out of ready
        -- (it no longer meets the definition of ready) until clarified.
}

rule ClarificationDeferred {
    when: DeferClarification(brick, clarify_title)
    requires: brick.stage = committed
    ensures:
        Brick.created(title: clarify_title, stage: committed, kind: meta,
            about: brick, atomicity: unknown)
}

rule PrioritySkipChallenged {
    when: skip: Skip.created
    requires: skip.reason = not_priority
    ensures: PriorityChallengeIssued(brick: skip.brick)

    @guidance
        -- "Then what IS a priority?" — the answer arrives as new
        -- RecordComparison stimuli producing a local re-sort.
}

rule WaitingSkipAsksForDetails {
    when: skip: Skip.created
    requires: skip.reason = waiting
    ensures: WaitDetailsRequested(brick: skip.brick)
}

rule WaitRecorded {
    when: RecordWait(brick, on_party?, condition_note?)
    requires: on_party != null or condition_note != null
    ensures: Wait.created(brick: brick, on_party: on_party,
        condition_note: condition_note, resolved: false)

    @guidance
        -- Waiting on another brick is modelled as a Dependency, not a Wait.
        -- Waits cover people and world conditions (place, opening hours,
        -- weekend). A waiting brick leaves the servable frontier.
}

rule WaitResolved {
    when: ResolveWait(wait)
    requires: wait.resolved = false
    ensures: wait.resolved = true
}

rule TiredSkipOffersRecovery {
    when: skip: Skip.created
    requires: skip.reason = tired
    ensures: RecoveryOptionsOffered(brick: skip.brick)

    @guidance
        -- Offer a question round (fatigue becomes system maintenance), a
        -- lighter brick, or rest. Never judgment.
}

rule MehSkipProposesTinyStep {
    when: skip: Skip.created
    requires: skip.reason = meh
    ensures: TinyStepProposed(brick: skip.brick)

    @guidance
        -- Aversion, acknowledged without judgment: a two-minute first step,
        -- pairing with the operator, or a break-down.
}

rule KillSkipDropsBrick {
    when: skip: Skip.created
    requires: skip.reason = kill
    requires: skip.brick.stage = ready
    ensures: skip.brick.stage = dropped
}

rule AlternativesSkipOpensSearch {
    when: skip: Skip.created
    requires: skip.reason = alternatives
    ensures: AlternativesRequested(brick: skip.brick)

    @guidance
        -- The goal stays, the method is rejected. The operator proposes 2-3
        -- alternative paths; the chosen one arrives as SupersedeBrick.
}

rule OtherSkipTracked {
    when: skip: Skip.created
    requires: skip.reason = other
    ensures: taxonomy.unreviewed_other_count = taxonomy.unreviewed_other_count + 1
}

rule TaxonomyReviewTriggered {
    when: watch: TaxonomyWatch.review_due
    ensures:
        watch.unreviewed_other_count = 0
        TaxonomyReviewProposed(watch: watch)

    @guidance
        -- Accumulated `other` skips are the sensor for evolving the skip
        -- taxonomy: the operator reviews their raw texts and proposes
        -- promoting a recurring pattern to a canonical reason.
}

-- Dependencies -----------------------------------------------

rule DependencyAdded {
    when: AddDependency(blocked, blocker)
    requires: blocked != blocker
    requires: not exists Dependency{blocked: blocked, blocker: blocker}
    ensures: Dependency.created(blocked: blocked, blocker: blocker)

    @guidance
        -- The dependency graph must stay acyclic; transitive cycle detection
        -- is algorithmic and belongs to the implementation. Blocked bricks
        -- leave the servable frontier and never appear in comparisons that
        -- would contradict the dependency order.
}

-- Prioritisation ---------------------------------------------

rule ComparisonRecorded {
    when: RecordComparison(earlier, later, author)
    requires: earlier != later
    let same = Comparison{before: earlier, after: later}
    let reverse = Comparison{before: later, after: earlier}
    requires: author = human or not exists same or same.author = ai
    requires: author = human or not exists reverse or reverse.author = ai
    ensures:
        not exists reverse
        if exists same:
            same.author = author
            same.recorded_at = now
            same.revalidation_requested = false
        else:
            Comparison.created(before: earlier, after: later, author: author,
                recorded_at: now, revalidation_requested: false)

    @guidance
        -- AI pre-orders (long runs the timsort-style merge exploits); the
        -- human settles the ambiguous few. A human answer overrides an AI
        -- one; an AI answer never displaces a human one.
}

rule ReadiedBrickCounted {
    when: brick: Brick.stage becomes ready
    ensures:
        order_watch.bricks_readied_since_round = order_watch.bricks_readied_since_round + 1
        if order_watch.clock_at = null:
            order_watch.clock_at = now

    @guidance
        -- Every brick entering the servable order lands as a mere creation-
        -- order tie-break until it is placed or sorted. The watch counts
        -- them, and the first one anchors the drift clock.
}

rule OrderSanityRoundProposedByBurst {
    when: watch: OrderWatch.round_due
    requires: watch.no_open_round
    ensures:
        let round = Brick.created(title: sanity_round_title(watch),
            stage: committed, kind: meta, atomicity: unknown)
        watch.bricks_readied_since_round = 0
        watch.clock_at = now
        watch.open_round = round

    @guidance
        -- The tolerance effect: below round_threshold newly-readied bricks,
        -- the order is left alone. At the threshold (e.g. the initial bulk
        -- load), a sanity-round meta-brick is spawned and served like any
        -- other work; the operator drives the org-sort-tasks merge strategy
        -- (one question per step, lazily, resumable) until the order is
        -- fully justified.
}

rule OrderSanityRoundProposedByDrift {
    when: watch: OrderWatch.clock_at + config.order_sanity_interval <= now
    requires: watch.no_open_round
    ensures:
        let round = Brick.created(title: sanity_round_title(watch),
            stage: committed, kind: meta, atomicity: unknown)
        watch.bricks_readied_since_round = 0
        watch.clock_at = now
        watch.open_round = round

    @guidance
        -- Priorities rot with time even when nothing new arrives — the same
        -- reason comparisons carry a shelf life. The implementation only
        -- fires this when there are at least two orderable bricks.
}

rule ComparisonGoesStale {
    when: comparison: Comparison.recorded_at + config.comparison_shelf_life <= now
    requires: comparison.revalidation_requested = false
    ensures:
        comparison.revalidation_requested = true
        RevalidationDue(comparison: comparison)

    @guidance
        -- Revalidation is a drip: the operator surfaces at most a question
        -- or two per session, prioritising stale comparisons near the top of
        -- the order. The drip is a floor, not a ceiling — question rounds
        -- batch these when the human has the energy.
}

-- Delegation -------------------------------------------------

rule BrickDelegated {
    when: DelegateBrick(brick, delegate)
    ensures:
        Delegation.created(brick: brick, delegate: delegate,
            status: to_notify, nudge_count: 0, nudge_pending: false)
}

rule DelegationNoticeDrafted {
    when: delegation: Delegation.created
    ensures: DelegationNoticeProposed(delegation: delegation)
}

rule DelegationNoticeApproved {
    when: ApproveDelegationNotice(delegation)
    requires: delegation.status = to_notify
    ensures:
        delegation.status = notified
        delegation.next_nudge_at = now + config.nudge_interval
}

rule DelegationCancelled {
    when: CancelDelegation(delegation)
    requires: delegation.status = to_notify
    ensures: delegation.status = abandoned
}

rule FollowUpComesDue {
    when: delegation: Delegation.next_nudge_at <= now
    requires: delegation.status in {notified, nudged}
    requires: delegation.nudge_pending = false
    ensures:
        delegation.nudge_pending = true
        FollowUpDue(delegation: delegation)
}

rule NudgeApproved {
    when: ApproveNudge(delegation)
    requires: delegation.nudge_pending = true
    requires: delegation.status in {notified, nudged}
    ensures:
        delegation.status = nudged
        delegation.nudge_count = delegation.nudge_count + 1
        delegation.next_nudge_at = now + config.nudge_interval
        delegation.nudge_pending = false
}

rule NudgeDeclined {
    when: DeclineNudge(delegation)
    requires: delegation.nudge_pending = true
    ensures:
        delegation.nudge_pending = false
        delegation.next_nudge_at = now + config.nudge_interval
}

rule DelegationCompleted {
    when: MarkDelegationCompleted(delegation)
    requires: delegation.status in {notified, nudged}
    ensures:
        delegation.status = completed
        delegation.nudge_pending = false
        delegation.next_nudge_at = null
}

rule DelegationRefused {
    when: MarkDelegationRefused(delegation)
    requires: delegation.status in {notified, nudged}
    ensures:
        delegation.status = refused
        delegation.nudge_pending = false
        delegation.next_nudge_at = null
}

rule DelegationAbandoned {
    when: MarkDelegationAbandoned(delegation)
    requires: delegation.status in {notified, nudged}
    ensures:
        delegation.status = abandoned
        delegation.nudge_pending = false
        delegation.next_nudge_at = null
}

-- Completion effects ----------------------------------------

rule CompletionEffectAdded {
    when: AddCompletionEffect(brick, kind, detail)
    requires: brick.stage in {seed, committed, ready, wip}
    ensures: FollowUpEffect.created(brick: brick, kind: kind, detail: detail,
        status: armed)
}

rule CompletionEffectsFired {
    when: brick: Brick.stage becomes done
    ensures:
        for effect in brick.completion_effects where status = armed and kind = spawn:
            effect.status = applied
            Brick.created(title: effect.detail, stage: committed,
                atomicity: unknown, about: brick)
        for effect in brick.completion_effects where status = armed and kind != spawn:
            effect.status = proposed
            ExternalActionProposed(effect: effect)

    @guidance
        -- spawn effects are internal (a follow-up brick) and need no
        -- approval. write_back and notify effects leave the system, so they
        -- stop at proposed until a human approves or declines.
}

rule ExternalActionApproved {
    when: ApproveExternalAction(effect)
    requires: effect.status = proposed
    ensures: effect.status = applied

    @guidance
        -- Execution goes through the WriteBackExecutor contract.
}

rule ExternalActionDeclined {
    when: DeclineExternalAction(effect)
    requires: effect.status = proposed
    ensures: effect.status = declined
}

-- External sources -------------------------------------------

rule SourceAttached {
    when: AttachSource(brick, type, url)
    requires: type != "" and url != ""
    requires: not exists SourceLink{brick: brick, url: url}
    ensures: SourceLink.created(brick: brick, type: type, url: url,
        diverged: false)

    @guidance
        -- Identity derives from the url alone: the same source of truth
        -- can't be attached twice to a brick under different types.
}

rule SourceChecked {
    when: RecordSourceCheck(link, snapshot)
    requires: link.diverged = false
    let drifted = link.last_fingerprint != null and link.last_fingerprint != snapshot.fingerprint
    ensures:
        if drifted:
            link.diverged = true
            Brick.created(title: reconcile_title(link), stage: committed,
                kind: meta, about: link.brick, atomicity: unknown)
            ReconciliationRequired(link: link)
        else:
            link.last_fingerprint = snapshot.fingerprint

    @guidance
        -- Sources are re-checked when a brick approaches execution and on a
        -- periodic drip. Divergence never auto-resolves: it becomes a
        -- reconcile meta-brick served like any other work.
}

rule DivergenceResolved {
    when: ResolveDivergence(link, snapshot)
    requires: link.diverged = true
    ensures:
        link.diverged = false
        link.last_fingerprint = snapshot.fingerprint
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant NoSelfComparison {
    for c in Comparisons:
        c.before != c.after
}

invariant NoContradictoryComparisons {
    for a in Comparisons:
        for b in Comparisons:
            a != b implies not (a.before = b.after and a.after = b.before)
}

invariant NoSelfDependency {
    for d in Dependencies:
        d.blocked != d.blocker
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Operator {
    identified_by: Party where party_type = ai_agent
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Intake {
    facing operator: Operator

    provides:
        CaptureSeed(title)
        CaptureRawInput(content)
        ExtractRawInput(raw, seed_titles)
        PromoteSeed(brick)
        KillBrick(brick)
        MarkReady(brick)
        AttributeRequest(brick, party)
        EnrichBrick(brick, kind?, context?, energy?, mode?, atomicity?, estimate_hours?, estimate_author?)
        DescribeBrick(brick, description)
        OpenSession(context_hint?, strictness)

    @guarantee NoFormsAtCapture
        -- Capture takes a title (or raw content) and nothing else. All other
        -- metadata is collected lazily, in drips, at the moment it is needed.
}

surface FocusLoop {
    facing operator: Operator
    context session: FocusSession where status = open

    exposes:
        session.context_hint
        session.strictness
        session.serve_count

    provides:
        RequestNext(session)
        CloseSession(session)
        StartBrick(brick)
        StopBrick(brick)
        CompleteBrick(brick)
        SkipBrick(brick, reason, raw_text?)
        DeferClarification(brick, clarify_title)
        RecordWait(brick, on_party?, condition_note?)
        ResolveWait(wait)
        BreakBrick(brick, part_titles)
        UnifyBricks(brick, into, reason?)
        SupersedeBrick(brick, replacement_title, reason?)
        DelegateBrick(brick, delegate)
        AddDependency(blocked, blocker)
        AddCompletionEffect(brick, kind, detail)

    @guarantee SessionAlwaysEndsInProposal
        -- Every interaction ends with a proposal (a focus, a question, an
        -- offer), never in silence.

    @guarantee NoStarvation
        -- Background-queue bricks provably move: every Nth serve comes from
        -- the background queue and skipped/waiting bricks accumulate aging
        -- pressure until they surface.

    @guarantee SkipsAreSignal
        -- A skip is never a bare dismissal: it always carries a reason, and
        -- each reason triggers a distinct, observable system response.
}

surface PriorityBench {
    facing operator: Operator

    provides:
        RecordComparison(earlier, later, author)

    @guarantee HumanPrecedence
        -- A human-authored comparison is never displaced by an AI-authored
        -- one. The human is the final judge of the total order.
}

surface DelegationDesk {
    facing operator: Operator
    context delegation: Delegation where status in {to_notify, notified, nudged}

    exposes:
        delegation.brick.title
        delegation.delegate.name
        delegation.status
        delegation.nudge_count
        delegation.nudge_pending

    provides:
        ApproveDelegationNotice(delegation) when delegation.status = to_notify
        CancelDelegation(delegation) when delegation.status = to_notify
        ApproveNudge(delegation) when delegation.nudge_pending
        DeclineNudge(delegation) when delegation.nudge_pending
        MarkDelegationCompleted(delegation)
        MarkDelegationRefused(delegation)
        MarkDelegationAbandoned(delegation)

    @guarantee OutboundContentPreviewed
        -- Notices and nudges are messages to third parties: their full
        -- content is always shown to the human before approval, in the
        -- recipient's language.
}

surface SourceGateway {
    facing operator: Operator

    provides:
        AttachSource(brick, type, url)
        RecordSourceCheck(link, snapshot)
        ResolveDivergence(link, snapshot)
        ApproveExternalAction(effect)
        DeclineExternalAction(effect)

    contracts:
        demands SourceReader
        demands WriteBackExecutor

    @guarantee NoSilentExternalActions
        -- Nothing leaves the system without the full outbound content being
        -- shown and explicitly approved first, even in the tersest UI mode.

    @guarantee DivergenceNeverAutoResolves
        -- When a source and its brick disagree, the system never merges
        -- silently: reconciliation is explicit, human-served work.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Decisions recorded by the project owner (Mica) on 2026-07-23 are folded in
-- below. Genuinely unresolved items remain as `open question` declarations.
-- Items that are decided but not yet built are kept as decided-direction notes
-- (implementation pending), so this spec never claims behaviour the core does
-- not yet have.

-- Core language and timing — resolved by reality: the Haskell core shipped as
-- v0 and implements this spec.

-- Estimates and definition of ready — decided direction (implementation
-- pending), merging the former estimates-timing and definition-of-ready
-- questions. Unit and format are settled: an estimate is hours as a Decimal
-- (estimate_hours), always carrying estimate_author (human | ai) so an AI
-- guess is marked as such. Nothing is ever mandatory before serving: the
-- operator placeholder-fills missing metadata with AI guesses (e.g.
-- estimate_author = ai) and the human corrects in drips. Preparation is a
-- "grooming" meta-brick — "prepare brick X" (estimate, dependencies, split
-- assessment, context, binary-insertion placement) — that spawns when a
-- committed brick approaches the top of the order, the same pattern as the
-- clarify and sanity-round meta-bricks. A grooming brick must never itself
-- require grooming: no meta-meta.
open question "Estimates: when they are collected, and the concrete AI-guesses / human-corrects drip flow."
open question "Definition of ready per kind: which fields the operator placeholder-fills per brick kind during grooming."

-- Scheduler defaults and comparison staleness — still open, with a shared
-- decision: the starting values are tuned by the AI operator via simulations
-- over real usage. Non-negotiable: every knob stays parameterisable (config),
-- never hard-coded.
open question "Scheduler defaults: background_serve_ratio, context_quantum, and the aging curve."
open question "Comparison staleness: decay function / half-life (comparison_shelf_life is a placeholder)."

-- Question-round composition — resolved as skill policy, not core mechanism:
-- the operator chooses the mix by reading system state. Stale comparisons push
-- ordering questions, a fat inbox pushes triage, an unprepared top of the
-- order pushes enrichment; a specific flavour can always be requested in free
-- text.

-- Reconciliation policy — decided direction (implementation pending) that
-- supersedes current behaviour: because the log is append-only, an upstream
-- change both auto-applies and notifies; the notice surfaces lazily at the
-- session boundary through the same status channel as nudges and delegations
-- (e.g. a sources_reconciled field), never interrupting mid-flow. Current
-- implemented behaviour still spawns a reconcile meta-brick on divergence
-- (rule SourceChecked, guarantee DivergenceNeverAutoResolves); the
-- auto-apply-and-notify policy supersedes it once built.

-- Multi-device transport (v2) — narrowed: pure git is rejected (mobile must be
-- a first-class device); the event-union endpoint is the leaning. Supporting
-- infrastructure is already implemented so devices on different binary
-- versions merge safely: per-event-type versions with an upcast boundary at
-- parse (LittleAnt.Upcast) and an atomic `la migrate` (hot log plus archives,
-- .vN.bak backups).
open question "Multi-device transport (v2): the concrete event-union endpoint design."

-- on_start triggers — decided (2026-07-23): yes, they should exist, mirroring
-- the completion effects. Implementation pending.
open question "on_start triggers: their concrete shape and semantics, mirroring completion effects."

-- Session-opening status line — decided direction (implementation pending):
-- the canonical status line is emitted by the core as a deterministic command
-- (planned `la status --line`) applying a mechanical only-actionables /
-- omit-zeros rule, so every LLM operator renders it identically; the operator
-- then adds a second, judgement line below it.
