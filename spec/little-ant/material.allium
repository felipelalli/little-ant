-- allium: 3
-- Little Ant 1.0 — durable source material and provenance.

use "./domain.allium" as domain

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract SourceReader {
    observe: (adapter: String, locator: String) -> Any
    fetch: (adapter: String, locator: String) -> Any

    @invariant NonDestructiveRead
        -- Observation and fetch never mutate the external source.

    @invariant AttributedResult
        -- Every result identifies its adapter, locator, observation time,
        -- authority, and external revision when the source exposes one.
}

contract CanonicalBlobStore {
    put: (
        content_hash: String,
        size: Integer,
        media_type: String,
        bytes: Any
    ) -> Any
    read: (content_hash: String) -> Any
    verify: (content_hash: String) -> Boolean

    @invariant ContentAddressedIntegrity
        -- Accepted bytes must match content_hash and size. Equal bytes may
        -- share physical storage without merging Raw identity or provenance.

    @invariant BlobIsLogicalDatasetContent
        -- Every available RawSnapshot's bytes participate in ordinary backup
        -- and dataset synchronization by default, independent of Git or any
        -- concrete storage and transport.

    @invariant MissingOrCorruptIsExplicit
        -- A referenced blob that cannot be read or verified changes snapshot
        -- availability to missing or corrupt; metadata alone is never treated
        -- as a complete snapshot.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum RawReviewState { pending | reviewed }
enum RawStorageState { active | archived }
enum SnapshotAvailability { available | missing | corrupt }
enum RawLinkRole { attachment | source | evidence | derived_from }
enum ExternalPresence { unknown | present | removed | unavailable }
enum ExternalWorkState { unknown | open | completed }
enum ReviewDispositionKind { retained | linked | produced_work | no_work }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Raw {
    id: String
    title: String?
    original_text: String?
    canonical_english: String?
    normalization_authority: domain/Authority?
    review_state: RawReviewState
    storage_state: RawStorageState
    created_at: Timestamp

    transitions review_state {
        pending -> reviewed
        reviewed -> pending
    }

    transitions storage_state {
        active -> archived
        archived -> active
    }

    origin: RawOrigin with raw = this
    snapshots: RawSnapshot with raw = this
    links: RawLink with raw = this
    memberships: RawShelfMembership with raw = this

    latest_snapshot: RawSnapshot? = latest_snapshot(snapshots)
}

entity RawOrigin {
    id: String
    raw: Raw
    adapter: String
    locator: String
    external_id: String?
    last_checked_at: Timestamp?
    last_observed_revision: String?
    historical_only: Boolean
    created_at: Timestamp

    observations: SourceObservation with origin = this
}

entity RawSnapshot {
    id: String
    raw: Raw
    content_hash: String
    size: Integer
    media_type: String
    captured_at: Timestamp
    origin_revision: String?
    availability: SnapshotAvailability
    verified_at: Timestamp?

    transitions availability {
        available -> missing
        available -> corrupt
        missing -> available
        corrupt -> available
    }
}

entity RawLink {
    id: String
    raw: Raw
    role: RawLinkRole
    owner_brick: domain/Brick?
    owner_entry: domain/ListEntry?
    owner_raw: Raw?
    reconciled_snapshot: RawSnapshot?
    created_at: Timestamp
}

entity RawShelf {
    id: String
    name: String
    created_at: Timestamp

    memberships: RawShelfMembership with shelf = this
}

entity RawShelfMembership {
    id: String
    raw: Raw
    shelf: RawShelf
    added_at: Timestamp
}

entity SourceObservation {
    id: String
    origin: RawOrigin
    observed_at: Timestamp
    authority: domain/Authority
    external_observation_id: String?
    revision: String?
    presence: ExternalPresence
    work_state: ExternalWorkState
    failure_detail: String?
}

entity RawReviewDisposition {
    id: String
    raw: Raw
    kind: ReviewDispositionKind
    brick: domain/Brick?
    recorded_at: Timestamp
    authority: domain/Authority
    note: String?
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule InlineRawCaptured {
    when: CaptureInlineRaw(original_text, canonical_english?, authority?)
    requires:
        canonical_english = null
        or canonical_english_text(canonical_english)
    requires:
        (canonical_english = null and authority = null)
        or (canonical_english != null and authority != null)
    ensures: Raw.created(
        id: new_id(),
        original_text: original_text,
        canonical_english: canonical_english,
        normalization_authority: authority,
        review_state: pending,
        storage_state: active,
        created_at: now)
}

rule ExternalRawCaptured {
    when: CaptureExternalRaw(title?, adapter, locator, external_id?)
    ensures:
        let raw = Raw.created(
            id: new_id(),
            title: title,
            review_state: pending,
            storage_state: active,
            created_at: now)
        RawOrigin.created(
            id: new_id(),
            raw: raw,
            adapter: adapter,
            locator: locator,
            external_id: external_id,
            historical_only: false,
            created_at: now)
}

rule RawSnapshotCaptured {
    when: CaptureRawSnapshot(raw, content_hash, size, media_type, origin_revision?)
    requires: size >= 0
    requires: not exists RawSnapshot{raw, content_hash}
    ensures: RawSnapshot.created(
        id: new_id(),
        raw: raw,
        content_hash: content_hash,
        size: size,
        media_type: media_type,
        captured_at: now,
        origin_revision: origin_revision,
        availability: available,
        verified_at: now)

    @guidance
        -- Identical immutable bytes may share physical blob storage, while
        -- distinct Raw entities and their provenance remain distinct.
}

rule ExistingRawSnapshotObservedAgain {
    when: CaptureRawSnapshot(raw, content_hash, size, media_type, origin_revision?)
    requires: exists RawSnapshot{raw, content_hash}
    ensures: RawSnapshotReused(raw: raw, content_hash: content_hash)
}

rule SnapshotReportedMissing {
    when: ReportSnapshotMissing(snapshot)
    requires: snapshot.availability in {available, corrupt}
    ensures:
        snapshot.availability = missing
        snapshot.verified_at = null
}

rule SnapshotReportedCorrupt {
    when: ReportSnapshotCorrupt(snapshot)
    requires: snapshot.availability in {available, missing}
    ensures:
        snapshot.availability = corrupt
        snapshot.verified_at = null
}

rule SnapshotRepaired {
    when: VerifySnapshotBytes(snapshot)
    requires: snapshot.availability in {missing, corrupt}
    ensures:
        snapshot.availability = available
        snapshot.verified_at = now
}

rule OriginObserved {
    when: RecordSourceObservation(
        origin,
        authority,
        external_observation_id?,
        revision?,
        presence,
        work_state,
        failure_detail?)
    ensures:
        SourceObservation.created(
            id: observation_id(origin, external_observation_id, revision, now),
            origin: origin,
            observed_at: now,
            authority: authority,
            external_observation_id: external_observation_id,
            revision: revision,
            presence: presence,
            work_state: work_state,
            failure_detail: failure_detail)
        origin.last_checked_at = now
        if revision != null:
            origin.last_observed_revision = revision

    @guarantee AbsenceIsNotCompletion
        -- Removed, unavailable, filtered, and completed are independent
        -- observations. None changes local Raw or Brick lifecycle state.
}

rule OriginRelocated {
    when: RelocateRawOrigin(origin, new_locator)
    ensures: origin.locator = new_locator

    @guidance
        -- Canonical event history preserves the prior locator.
}

rule OriginRetiredAfterMigration {
    when: RetireRawOrigin(origin)
    requires: origin.historical_only = false
    ensures: origin.historical_only = true
}

rule RawReviewed {
    when: ReviewRaw(raw, kind, brick?, authority, note?)
    requires: raw.review_state = pending
    ensures:
        raw.review_state = reviewed
        RawReviewDisposition.created(
            id: new_id(),
            raw: raw,
            kind: kind,
            brick: brick,
            recorded_at: now,
            authority: authority,
            note: note)
}

rule RawReopened {
    when: ReopenRaw(raw)
    requires: raw.review_state = reviewed
    ensures: raw.review_state = pending
}

rule RawArchived {
    when: ArchiveRaw(raw)
    requires: raw.storage_state = active
    ensures: raw.storage_state = archived
}

rule RawUnarchived {
    when: UnarchiveRaw(raw)
    requires: raw.storage_state = archived
    ensures: raw.storage_state = active
}

rule RawLinkedToBrick {
    when: LinkRawToBrick(raw, brick, role, baseline?)
    requires: role in {attachment, source, evidence}
    requires: not exists RawLink{
        raw: raw,
        role: role,
        owner_brick: brick
    }
    ensures: RawLink.created(
        id: new_id(),
        raw: raw,
        role: role,
        owner_brick: brick,
        reconciled_snapshot: baseline,
        created_at: now)
}

rule RawLinkedToEntry {
    when: LinkRawToEntry(raw, entry, role)
    requires: role in {attachment, source, evidence}
    requires: not exists RawLink{
        raw: raw,
        role: role,
        owner_entry: entry
    }
    ensures: RawLink.created(
        id: new_id(),
        raw: raw,
        role: role,
        owner_entry: entry,
        created_at: now)
}

rule RawDerivedFromRaw {
    when: LinkDerivedRaw(raw, source)
    requires: raw != source
    requires: not exists RawLink{
        raw: source,
        role: derived_from,
        owner_raw: raw
    }
    ensures: RawLink.created(
        id: new_id(),
        raw: source,
        role: derived_from,
        owner_raw: raw,
        created_at: now)
}

rule SourceLinkReconciled {
    when: ReconcileRawLink(link, snapshot)
    requires: link.role in {source, evidence}
    requires: snapshot.raw = link.raw
    ensures: link.reconciled_snapshot = snapshot
}

rule RawShelfCreated {
    when: CreateRawShelf(name)
    ensures: RawShelf.created(id: new_id(), name: name, created_at: now)
}

rule RawAddedToShelf {
    when: AddRawToShelf(raw, shelf)
    requires: not exists RawShelfMembership{raw, shelf}
    ensures: RawShelfMembership.created(
        id: new_id(),
        raw: raw,
        shelf: shelf,
        added_at: now)
}

rule RawRemovedFromShelf {
    when: RemoveRawFromShelf(raw, shelf)
    let membership = RawShelfMembership{raw, shelf}
    requires: exists membership
    ensures: not exists membership
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant AtMostOneOriginPerRaw {
    for first in RawOrigins:
        for second in RawOrigins:
            first.raw = second.raw implies first = second
}

invariant RawNormalizationIsAttributed {
    for raw in Raws:
        (raw.canonical_english = null
            and raw.normalization_authority = null)
        or
        (raw.canonical_english != null
            and raw.normalization_authority != null)
}

invariant DerivedRawLinkOwnsRaw {
    for link in RawLinks:
        link.role = derived_from implies link.owner_raw != null
}

invariant WorkRawLinkOwnsBrickOrEntry {
    for link in RawLinks:
        link.role in {attachment, source, evidence} implies
            link.owner_raw = null
}

invariant RawLinkHasExactlyOneOwner {
    for link in RawLinks:
        (link.owner_brick != null or link.owner_entry != null or link.owner_raw != null)
        and not (link.owner_brick != null and link.owner_entry != null)
        and not (link.owner_brick != null and link.owner_raw != null)
        and not (link.owner_entry != null and link.owner_raw != null)
}

invariant SnapshotBelongsToLinkedRaw {
    for link in RawLinks:
        link.reconciled_snapshot != null implies
            link.reconciled_snapshot.raw = link.raw
}

invariant ShelvesAreFlat {
    -- RawShelfMembership can target only Raw and RawShelf; no shelf can be
    -- a member of another shelf.
    true
}

invariant NoPermanentRawDeletion {
    -- Version 1.0 exposes archive and unarchive, never destructive Raw
    -- deletion or automatic blob garbage collection.
    true
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor User {
    identified_by: domain/Party where party_type = person
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface MaterialDesk {
    facing user: User

    exposes:
        user.id

    provides:
        CaptureInlineRaw(original_text, canonical_english?, authority?)
        CaptureExternalRaw(title?, adapter, locator, external_id?)
        CaptureRawSnapshot(raw, content_hash, size, media_type, origin_revision?)
        ReportSnapshotMissing(snapshot)
        ReportSnapshotCorrupt(snapshot)
        VerifySnapshotBytes(snapshot)
        RecordSourceObservation(
            origin,
            authority,
            external_observation_id?,
            revision?,
            presence,
            work_state,
            failure_detail?)
        RelocateRawOrigin(origin, new_locator)
        RetireRawOrigin(origin)
        ReviewRaw(raw, kind, brick?, authority, note?)
        ReopenRaw(raw)
        ArchiveRaw(raw)
        UnarchiveRaw(raw)
        LinkRawToBrick(raw, brick, role, baseline?)
        LinkRawToEntry(raw, entry, role)
        LinkDerivedRaw(raw, source)
        ReconcileRawLink(link, snapshot)
        CreateRawShelf(name)
        AddRawToShelf(raw, shelf)
        RemoveRawFromShelf(raw, shelf)

    contracts:
        demands SourceReader
        demands CanonicalBlobStore

    @guarantee MaterialIsNotWork
        -- Raw and RawShelf never receive priority position, focus, done, or
        -- direct next-selection semantics.

    @guarantee ExplicitExternalAccess
        -- Fetch, refresh, and observation are explicit or authorized by an
        -- inspectable active import policy; ordinary rendering performs no
        -- hidden I/O.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Retry, backoff, quota, and remote-tiering defaults remain adapter or implementation policy."
