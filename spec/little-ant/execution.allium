-- allium: 3
-- Little Ant 1.0 — lifecycle, execution, recurrence, and context.

use "./domain.allium" as domain
use "./judgment.allium" as judgment

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    focus: domain/FocusRegister
    root_priority: judgment/PriorityScope
    standard_behavior: domain/BrickBehavior
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum WaitStatus { open | resolved | cancelled }
enum DependencyStatus { active | satisfied | cancelled }
enum DelegationStatus {
    awaiting_approval |
    notified |
    in_progress |
    completed |
    refused |
    abandoned
}
enum ExecutionStatus { running | finished | abandoned }
enum ExecutionOutcome { done | partial | abandoned }
enum SkipReason {
    hard |
    vague |
    not_priority |
    waiting |
    tired |
    meh |
    kill |
    alternatives |
    other
}
enum NoticeKind {
    best_before_approaching |
    best_before_passed |
    deadline_approaching |
    deadline_overdue
}
enum NoticeStatus { pending | acknowledged | snoozed | resolved }
enum RecurrenceKind { obligation | practice }
enum ScheduleStatus { active | paused | retired }
enum PracticeOpportunityStatus { open | done | not_done | not_applicable }
enum OpportunityTriggerStatus { active | retired }
enum PlaceStrength { hard | soft }
enum LocationObservationKind { entered | left | present }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Wait {
    id: String
    brick: domain/Brick
    on_party: domain/Party?
    condition: String
    status: WaitStatus
    created_at: Timestamp
    resolved_at: Timestamp?

    transitions status {
        open -> resolved
        open -> cancelled
        terminal: resolved, cancelled
    }
}

entity Dependency {
    id: String
    blocked: domain/Brick
    blocker: domain/Brick
    status: DependencyStatus
    created_at: Timestamp
    resolved_at: Timestamp?

    transitions status {
        active -> satisfied
        active -> cancelled
        terminal: satisfied, cancelled
    }
}

entity Delegation {
    id: String
    brick: domain/Brick
    delegate: domain/Party
    status: DelegationStatus
    instructions: String
    created_at: Timestamp
    last_contact_at: Timestamp?
    next_followup_at: Timestamp?
    result_note: String?

    transitions status {
        awaiting_approval -> notified
        awaiting_approval -> abandoned
        notified -> in_progress
        notified -> completed
        notified -> refused
        notified -> abandoned
        in_progress -> completed
        in_progress -> refused
        in_progress -> abandoned
        terminal: completed, refused, abandoned
    }
}

entity ExecutionOccurrence {
    id: String
    brick: domain/Brick
    status: ExecutionStatus
    started_at: Timestamp?
    finished_at: Timestamp?
    outcome: ExecutionOutcome?
    completion_note: String?

    transitions status {
        running -> finished
        running -> abandoned
        terminal: finished, abandoned
    }
}

entity ServedSkip {
    id: String
    brick: domain/Brick
    reason: SkipReason
    raw_text: String?
    recorded_at: Timestamp
}

entity DateNotice {
    id: String
    brick: domain/Brick
    kind: NoticeKind
    date_value: Timestamp
    date_revision: String
    status: NoticeStatus
    created_at: Timestamp
    snoozed_until: Timestamp?

    transitions status {
        pending -> acknowledged
        pending -> snoozed
        pending -> resolved
        snoozed -> pending
        snoozed -> acknowledged
        snoozed -> resolved
        acknowledged -> resolved
        terminal: resolved
    }
}

entity RecurrenceRule {
    id: String
    target: domain/Brick
    kind: RecurrenceKind
    schedule: String
    timezone: String
    status: ScheduleStatus
    next_release_at: Timestamp
    created_at: Timestamp

    practice_history: PracticeHistoryView? =
        if kind = practice:
            practice_history_view(this)
        else: null

    transitions status {
        active -> paused
        active -> retired
        paused -> active
        paused -> retired
        terminal: retired
    }
}

entity ObligationOccurrence {
    id: String
    rule: RecurrenceRule
    period_key: String
    brick: domain/Brick
    released_at: Timestamp
}

entity RecurrenceRevision {
    id: String
    rule: RecurrenceRule
    prior_schedule: String
    new_schedule: String
    prior_timezone: String
    new_timezone: String
    next_release_at: Timestamp
    reason: String
    authority: domain/Authority
    revised_at: Timestamp
}

entity PracticeOpportunity {
    id: String
    rule: RecurrenceRule
    period_key: String
    status: PracticeOpportunityStatus
    window_start: Timestamp
    window_end: Timestamp
    resolved_at: Timestamp?
    reason: String?

    transitions status {
        open -> done
        open -> not_done
        open -> not_applicable
        terminal: done, not_done, not_applicable
    }
}

entity OpportunityTrigger {
    id: String
    source: domain/Brick
    target: domain/Brick
    status: OpportunityTriggerStatus
    created_at: Timestamp

    transitions status {
        active -> retired
        terminal: retired
    }
}

entity TriggeredOpportunity {
    id: String
    trigger: OpportunityTrigger
    source_event_id: String
    target: domain/Brick
    released_at: Timestamp
    consumed_at: Timestamp?
}

entity Place {
    id: String
    label: String
    created_at: Timestamp
}

entity PlaceCondition {
    id: String
    brick: domain/Brick
    place: Place
    strength: PlaceStrength
    created_at: Timestamp
}

entity LocationObservation {
    id: String
    place: Place
    kind: LocationObservationKind
    observed_at: Timestamp
    expires_at: Timestamp
    authority: domain/Authority
    source: String
    external_observation_id: String?
}

------------------------------------------------------------
-- Derived practice projection
------------------------------------------------------------

value PracticeHistoryView {
    target: domain/Brick
    marks: List<String>
    current_streak: Integer
    best_streak: Integer
    applicable_count: Integer
    done_count: Integer
    not_done_count: Integer
}

contract PracticeProjection {
    history: (
        recurrence: RecurrenceRule,
        through: Timestamp,
        limit: Integer
    ) -> PracticeHistoryView

    @invariant DerivedFromOccurrenceHistory
        -- Marks and streaks derive from ordered done, not_done, and
        -- not_applicable opportunities. They are never mutable scores.

    @invariant InapplicableDoesNotBreakStreak
        -- A window blocked or paused before applicability is displayed
        -- separately and neither creates failure evidence nor loses a streak.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    soft_wip_limit: Integer = 3
    best_before_notice_lead: Duration = 7.days
    deadline_notice_lead: Duration = 7.days
    location_observation_ttl: Duration = 4.hours
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Brick metadata ----------------------------------------------------------

rule BrickRenamed {
    when: RenameBrick(brick, title, authority)
    requires: brick.status = active
    requires: canonical_english_text(title)
    ensures:
        brick.title = title
        brick.title_authority = authority

    @guarantee IdentitySurvivesRename
        -- Rename changes search and display text, never the opaque Brick ID.
}

rule BrickOriginalTitleSet {
    when: SetBrickOriginalTitle(brick, original_title)
    requires: brick.status = active
    ensures: brick.original_title = original_title
}

rule BrickOriginalTitleCleared {
    when: ClearBrickOriginalTitle(brick)
    requires: brick.status = active
    requires: brick.original_title != null
    ensures: brick.original_title = null
}

rule BrickDescribed {
    when: DescribeBrick(brick, description)
    requires: brick.status = active
    ensures:
        brick.description = description
        brick.description_revision = brick.description_revision + 1
        ScopeReviewSuggested(brick: brick, reason: "description_changed")
}

rule BrickDescriptionCleared {
    when: ClearBrickDescription(brick)
    requires: brick.status = active
    requires: brick.description != null
    ensures:
        brick.description = null
        brick.description_revision = brick.description_revision + 1
        ScopeReviewSuggested(brick: brick, reason: "description_cleared")
}

rule BrickPhaseSet {
    when: SetBrickPhase(brick, phase, authority)
    requires: brick.status = active
    requires: brick.behavior.phase = applicable
    ensures:
        brick.phase = phase
        brick.phase_authority = authority
}

rule BrickPhaseCleared {
    when: ClearBrickPhase(brick)
    requires: brick.status = active
    requires: brick.behavior.phase = applicable
    ensures:
        brick.phase = null
        brick.phase_authority = null
}

rule BrickContextSet {
    when: SetBrickContext(brick, context)
    requires: brick.status = active
    ensures: brick.context = context
}

rule BrickContextCleared {
    when: ClearBrickContext(brick)
    requires: brick.status = active
    requires: brick.context != null
    ensures: brick.context = null
}

rule BrickModeSet {
    when: SetBrickMode(brick, mode)
    requires: brick.status = active
    ensures: brick.mode = mode
}

rule BrickModeCleared {
    when: ClearBrickMode(brick)
    requires: brick.status = active
    requires: brick.mode != null
    ensures: brick.mode = null
}

rule BrickNotBeforeSet {
    when: SetBrickNotBefore(brick, value)
    requires: brick.status = active
    ensures:
        brick.not_before = value
        brick.date_revision = brick.date_revision + 1
        DateConfigurationChanged(brick: brick)
}

rule BrickNotBeforeCleared {
    when: ClearBrickNotBefore(brick)
    requires: brick.status = active
    requires: brick.not_before != null
    ensures:
        brick.not_before = null
        brick.date_revision = brick.date_revision + 1
        DateConfigurationChanged(brick: brick)
}

rule BrickBestBeforeSet {
    when: SetBrickBestBefore(brick, value)
    requires: brick.status = active
    ensures:
        brick.best_before = value
        brick.date_revision = brick.date_revision + 1
        DateConfigurationChanged(brick: brick)
}

rule BrickBestBeforeCleared {
    when: ClearBrickBestBefore(brick)
    requires: brick.status = active
    requires: brick.best_before != null
    ensures:
        brick.best_before = null
        brick.date_revision = brick.date_revision + 1
        DateConfigurationChanged(brick: brick)
}

rule BrickDeadlineSet {
    when: SetBrickDeadline(brick, value)
    requires: brick.status = active
    ensures:
        brick.deadline = value
        brick.date_revision = brick.date_revision + 1
        DateConfigurationChanged(brick: brick)
}

rule BrickDeadlineCleared {
    when: ClearBrickDeadline(brick)
    requires: brick.status = active
    requires: brick.deadline != null
    ensures:
        brick.deadline = null
        brick.date_revision = brick.date_revision + 1
        DateConfigurationChanged(brick: brick)
}

rule BrickRequesterSet {
    when: SetBrickRequester(brick, requester)
    requires: brick.status = active
    ensures: brick.requester = requester
}

rule BrickRequesterCleared {
    when: ClearBrickRequester(brick)
    requires: brick.status = active
    requires: brick.requester != null
    ensures: brick.requester = null
}

rule BrickAboutSet {
    when: SetBrickAbout(brick, about)
    requires: brick.status = active
    requires: brick != about
    ensures: brick.about = about
}

rule BrickAboutCleared {
    when: ClearBrickAbout(brick)
    requires: brick.status = active
    requires: brick.about != null
    ensures: brick.about = null
}

-- Focus and WIP -----------------------------------------------------------

rule IdleBrickFocused {
    when: FocusBrick(brick)
    requires: brick.status = active
    requires: brick.work_state = idle
    requires: can_focus_now(brick, now)
    ensures:
        brick.work_state = wip
        focus.current = brick
        focus.changed_at = now
        if active_human_wip_count() + 1 > config.soft_wip_limit:
            WipReviewSuggested(brick: brick)
}

rule ExistingWipFocused {
    when: FocusBrick(brick)
    requires: brick.status = active
    requires: brick.work_state = wip
    requires: can_focus_now(brick, now)
    ensures:
        focus.current = brick
        focus.changed_at = now
}

rule CurrentBrickUnfocused {
    when: UnfocusCurrentBrick()
    requires: focus.current != null
    ensures:
        focus.current = null
        focus.changed_at = now
}

rule WipReturnedToIdle {
    when: ReturnBrickToIdle(brick)
    requires: brick.status = active
    requires: brick.work_state = wip
    requires: focus.current != brick
    ensures: brick.work_state = idle
}

-- Direct lifecycle --------------------------------------------------------

rule FiniteBrickCompletedDirectly {
    when: CompleteBrick(brick, note?)
    requires: brick.status = active
    requires: brick.behavior.lifetime = finite
    requires: brick.active_children.count = 0
    ensures:
        brick.status = done
        brick.status_changed_at = now
        brick.work_state = idle
        if focus.current = brick:
            focus.current = null
            focus.changed_at = now
        BrickCompletionRecorded(
            brick: brick,
            note: note,
            prior_start_known: has_execution_history(brick))

    @guarantee HonestDirectCompletion
        -- No start, preparation, phase transition, duration, or zero-duration
        -- execution is fabricated when completion is reported directly.
}

rule StandingBrickRetiredAsDone {
    when: RetireStandingBrick(brick, note?)
    requires: brick.status = active
    requires: brick.behavior.lifetime = standing
    requires: brick.active_children.count = 0
    ensures:
        brick.status = done
        brick.status_changed_at = now
        brick.work_state = idle
        if focus.current = brick:
            focus.current = null
            focus.changed_at = now
        for recurrence in RecurrenceRules
            where target = brick and status in {active, paused}:
            recurrence.status = retired
        BrickCompletionRecorded(
            brick: brick,
            note: note,
            prior_start_known: has_execution_history(brick))
}

rule LeafBrickDropped {
    when: DropBrick(brick, reason?)
    requires: brick.status = active
    requires: brick.active_children.count = 0
    ensures:
        brick.status = dropped
        brick.status_changed_at = now
        brick.work_state = idle
        if focus.current = brick:
            focus.current = null
            focus.changed_at = now
        BrickDropped(brick: brick, reason: reason)
}

rule BrickSupersededByExistingBrick {
    when: SupersedeBrick(brick, replacement, reason?)
    requires: brick.status = active
    requires: replacement.status = active
    requires: brick != replacement
    requires: brick.parent = replacement.parent
    requires: brick.active_children.count = 0
    ensures:
        brick.status = superseded
        brick.status_changed_at = now
        brick.work_state = idle
        brick.superseded_by = replacement
        brick.supersede_reason = reason
        if focus.current = brick:
            focus.current = null
            focus.changed_at = now

    @guarantee NoImplicitTransfer
        -- Children, dependencies, recurrence, triggers, streaks, and priority
        -- evidence are never silently copied to the replacement.
}

rule BrickSupersededWithExplicitChildTransfer {
    when: SupersedeBrickWithChildren(
        brick,
        replacement,
        selected_children,
        reason?)
    requires: brick.status = active
    requires: replacement.status = active
    requires: brick != replacement
    requires: brick.parent = replacement.parent
    requires:
        selected_children = brick.active_children
    requires:
        selected_children.count > 0
    let old_scope = judgment/PriorityScope{parent: brick}
    let new_scope = judgment/PriorityScope{parent: replacement}
    let ordered_children =
        preserve_scope_order(old_scope.members, selected_children)
    let transfer_seed =
        transfer_evidence(brick, replacement, ordered_children, now)
    ensures:
        for comparison in judgment/PriorityJudgments
            where scope = old_scope and applicable:
            comparison.applicable = false
        old_scope.members = []
        old_scope.revision = old_scope.revision + 1
        for child in ordered_children:
            child.parent = replacement
            DateConfigurationChanged(brick: child)
        new_scope.members = provisional_block_insert(
            new_scope.members,
            ordered_children,
            transfer_seed)
        new_scope.revision = new_scope.revision + 1
        for child in ordered_children:
            judgment/PriorityInsertion.created(
                id: new_id(),
                brick: child,
                scope: new_scope,
                status: deferred,
                comparisons_recorded: 0,
                consecutive_skips: 0,
                random_evidence:
                    child_transfer_evidence(transfer_seed, child),
                started_at: now,
                finished_at: now)
        replacement.decomposition_coverage = open
        ScopeReviewSuggested(
            brick: replacement,
            reason: "children_transferred_from_superseded_brick")
        brick.status = superseded
        brick.status_changed_at = now
        brick.work_state = idle
        brick.superseded_by = replacement
        brick.supersede_reason = reason
        if focus.current = brick:
            focus.current = null
            focus.changed_at = now

    @guarantee TransferIsExplicitAndComplete
        -- Every still-active direct child is named in one atomic transfer.
        -- Unselected active descendants cannot remain under a terminal Brick.

    @guarantee ChildSubtreesAndRelativeOrderSurvive
        -- Each transferred child's descendants and the selected children's
        -- prior relative order are preserved. Their placement among the
        -- replacement's existing children remains provisional and reviewable.
}

rule WholeSubtreeCompleted {
    when: CompleteSubtree(root, note?)
    requires: root.status = active
    ensures:
        for brick in subtree(root) where status = active:
            brick.status = done
            brick.status_changed_at = now
            brick.work_state = idle
            BrickCompletionRecorded(
                brick: brick,
                note: note,
                prior_start_known: has_execution_history(brick))
        if focus.current in subtree(root):
            focus.current = null
            focus.changed_at = now
}

rule WholeSubtreeDropped {
    when: DropSubtree(root, reason?)
    requires: root.status = active
    ensures:
        for brick in subtree(root) where status = active:
            brick.status = dropped
            brick.status_changed_at = now
            brick.work_state = idle
            BrickDropped(brick: brick, reason: reason)
        if focus.current in subtree(root):
            focus.current = null
            focus.changed_at = now
}

rule ActiveSubtreeMoved {
    when: MoveSubtreeUnderParent(root, new_parent)
    requires: root.status = active
    requires: root.parent != new_parent
    requires: new_parent.status = active
    requires: new_parent not in subtree(root)
    let old_parent = root.parent
    let old_scope = judgment/PriorityScope{parent: old_parent}
    let new_scope = priority_scope_for(new_parent, root_priority)
    let new_scope_was_empty = new_scope.members.count = 0
    let move_evidence =
        movement_evidence(root, old_parent, new_parent, now)
    let moved_root = root
    ensures:
        old_scope.members = remove_ordered(old_scope.members, root)
        old_scope.revision = old_scope.revision + 1
        for comparison in judgment/PriorityJudgments
            where scope = old_scope
            and applicable
            and (
                more_important = root
                or less_important = root
            ):
            comparison.applicable = false
        root.parent = new_parent
        DateConfigurationChanged(brick: root)
        new_scope.members = provisional_insert(
            new_scope.members,
            root,
            root.phase,
            move_evidence)
        new_scope.revision = new_scope.revision + 1
        judgment/PriorityInsertion.created(
            id: new_id(),
            brick: root,
            scope: new_scope,
            status: if new_scope_was_empty: resolved else: deferred,
            comparisons_recorded: 0,
            consecutive_skips: 0,
            random_evidence: move_evidence,
            started_at: now,
            finished_at: now)
        if old_parent != null:
            old_parent.decomposition_coverage = open
            ScopeReviewSuggested(
                brick: old_parent,
                reason: "child_moved_out")
        new_parent.decomposition_coverage = open
        ScopeReviewSuggested(
            brick: new_parent,
            reason: "child_moved_in")
        if old_parent = null:
            for assessment in judgment/ImpactAssessments
                where root = moved_root and applicable:
                assessment.applicable = false
            for comparison in judgment/ImpactComparisons
                where applicable
                and (
                    left = root
                    or right = root
                ):
                comparison.applicable = false

    @guarantee InternalSubtreeOrderIsPreserved
        -- Moving changes only the moved root's parent and sibling position.
        -- Descendant parents, sibling lists, identities, evidence, and
        -- internal priority paths remain untouched.

    @guarantee OldScopeEvidenceRemainsHistorical
        -- Priority evidence from the old parent becomes inapplicable but is
        -- never deleted. A non-trivial new scope gets ordinary priority-probe
        -- pressure rather than inheriting the old scope's order.
}

rule ActiveSubtreeMovedToRoot {
    when: MoveSubtreeToRoot(root)
    requires: root.status = active
    requires: root.parent != null
    let old_parent = root.parent
    let old_scope = judgment/PriorityScope{parent: old_parent}
    let new_scope_was_empty = root_priority.members.count = 0
    let move_evidence =
        movement_evidence(root, old_parent, null, now)
    ensures:
        old_scope.members = remove_ordered(old_scope.members, root)
        old_scope.revision = old_scope.revision + 1
        for comparison in judgment/PriorityJudgments
            where scope = old_scope
            and applicable
            and (
                more_important = root
                or less_important = root
            ):
            comparison.applicable = false
        root.parent = null
        DateConfigurationChanged(brick: root)
        root_priority.members = provisional_insert(
            root_priority.members,
            root,
            root.phase,
            move_evidence)
        root_priority.revision = root_priority.revision + 1
        judgment/PriorityInsertion.created(
            id: new_id(),
            brick: root,
            scope: root_priority,
            status: if new_scope_was_empty: resolved else: deferred,
            comparisons_recorded: 0,
            consecutive_skips: 0,
            random_evidence: move_evidence,
            started_at: now,
            finished_at: now)
        old_parent.decomposition_coverage = open
        ScopeReviewSuggested(
            brick: old_parent,
            reason: "child_moved_out")

    @guarantee InternalSubtreeOrderIsPreserved
        -- Becoming a root changes only the moved Brick's parent and root
        -- position. Every descendant relationship and internal sibling order
        -- remains unchanged.
}

-- Priority cleanup and parent review -------------------------------------

rule TerminalRootRemovedFromPriority {
    when: brick: domain/Brick.status transitions_to done | dropped | superseded
    requires: brick.parent = null
    requires: brick in root_priority.members
    ensures:
        root_priority.members =
            remove_ordered(root_priority.members, brick)
        root_priority.revision =
            root_priority.revision + 1
        for judgment in judgment/PriorityJudgments
            where applicable
            and (
                more_important = brick
                or less_important = brick
            ):
            judgment.applicable = false
}

rule TerminalChildRemovedFromPriority {
    when: brick: domain/Brick.status transitions_to done | dropped | superseded
    requires: brick.parent != null
    let scope = judgment/PriorityScope{parent: brick.parent}
    requires: brick in scope.members
    ensures:
        scope.members = remove_ordered(scope.members, brick)
        scope.revision = scope.revision + 1
        for judgment in judgment/PriorityJudgments
            where applicable
            and (
                more_important = brick
                or less_important = brick
            ):
            judgment.applicable = false
}

rule LastActiveChildClosed {
    when: child: domain/Brick.status transitions_to done | dropped | superseded
    requires: child.parent != null
    requires: child.parent.status = active
    requires: child.parent.behavior.lifetime = finite
    requires: child.parent.active_children.count = 0
    ensures: ParentReviewSuggested(parent: child.parent)

    @guarantee NoCompletionCascade
        -- Closing the final child proposes review. It never completes the
        -- parent or any ancestor automatically.
}

-- Waits, dependencies, and delegation -----------------------------------

rule WaitAdded {
    when: AddWait(brick, on_party?, condition)
    requires: brick.status = active
    ensures: Wait.created(
        id: new_id(),
        brick: brick,
        on_party: on_party,
        condition: condition,
        status: open,
        created_at: now)
}

rule WaitResolved {
    when: ResolveWait(wait)
    requires: wait.status = open
    ensures:
        wait.status = resolved
        wait.resolved_at = now
}

rule WaitCancelled {
    when: CancelWait(wait)
    requires: wait.status = open
    ensures:
        wait.status = cancelled
        wait.resolved_at = now
}

rule DependencyAdded {
    when: AddDependency(blocked, blocker)
    requires: blocked != blocker
    requires: blocked.status = active
    requires: blocker.status = active
    requires: not creates_dependency_cycle(blocked, blocker)
    requires: not exists Dependency{blocked, blocker, status: active}
    ensures: Dependency.created(
        id: new_id(),
        blocked: blocked,
        blocker: blocker,
        status: active,
        created_at: now)

    @guarantee DependencyDoesNotReorder
        -- Blocking changes eligibility and pressure, never human priority.
}

rule DependencySatisfiedByCompletion {
    when: blocker_brick: domain/Brick.status transitions_to done
    for dependency in Dependencies
        where blocker = blocker_brick and status = active:
        ensures:
            dependency.status = satisfied
            dependency.resolved_at = now
}

rule DependencyCancelledByNonCompletion {
    when: blocker_brick:
        domain/Brick.status transitions_to dropped | superseded
    for dependency in Dependencies
        where blocker = blocker_brick and status = active:
        ensures:
            dependency.status = cancelled
            dependency.resolved_at = now
            DependencyReviewSuggested(blocked: dependency.blocked)
}

rule DependencyRemovedExplicitly {
    when: CancelDependency(dependency)
    requires: dependency.status = active
    ensures:
        dependency.status = cancelled
        dependency.resolved_at = now
}

rule DelegationDrafted {
    when: DelegateBrick(brick, delegate, instructions, next_followup_at?)
    requires: brick.status = active
    ensures: Delegation.created(
        id: new_id(),
        brick: brick,
        delegate: delegate,
        status: awaiting_approval,
        instructions: instructions,
        created_at: now,
        next_followup_at: next_followup_at)
}

rule DelegationApprovedAndNotified {
    when: ApproveDelegationNotice(delegation)
    requires: delegation.status = awaiting_approval
    ensures:
        delegation.status = notified
        delegation.last_contact_at = now
}

rule DelegationStarted {
    when: MarkDelegationInProgress(delegation)
    requires: delegation.status = notified
    ensures: delegation.status = in_progress
}

rule DelegationCompleted {
    when: MarkDelegationCompleted(delegation, result_note?)
    requires: delegation.status in {notified, in_progress}
    ensures:
        delegation.status = completed
        delegation.result_note = result_note
}

rule DelegationRefused {
    when: MarkDelegationRefused(delegation, result_note?)
    requires: delegation.status in {notified, in_progress}
    ensures:
        delegation.status = refused
        delegation.result_note = result_note
}

rule DelegationAbandoned {
    when: AbandonDelegation(delegation, result_note?)
    requires: delegation.status in {
        awaiting_approval,
        notified,
        in_progress
    }
    ensures:
        delegation.status = abandoned
        delegation.result_note = result_note
}

-- Served skips ------------------------------------------------------------

rule ServedBrickSkipped {
    when: SkipServedBrick(brick, reason, raw_text?)
    requires: brick.status = active
    requires: reason != other or raw_text != null
    ensures:
        ServedSkip.created(
            id: new_id(),
            brick: brick,
            reason: reason,
            raw_text: raw_text,
            recorded_at: now)
        ServedSkipRecorded(brick: brick, reason: reason)

    @guarantee SkipIsNotCompletion
        -- Completion is the separate CompleteBrick or execution-completion
        -- action. No skip reason means already done.
}

-- Structured entries -----------------------------------------------------

rule ListEntryAdded {
    when: AddListEntry(
        owner,
        label,
        original_label?,
        authority,
        quantity?,
        note?)
    requires: owner.status = active
    requires: owner.behavior.owns_entries = true
    requires: canonical_english_text(label)
    ensures: domain/ListEntry.created(
        id: new_id(),
        owner: owner,
        label: label,
        original_label: original_label,
        label_authority: authority,
        quantity: quantity,
        note: note,
        status: open,
        created_at: now)
}

rule ListEntryResolved {
    when: ResolveListEntry(entry)
    requires: entry.status = open
    ensures:
        entry.status = resolved
        entry.resolved_at = now
}

rule ListEntryRemoved {
    when: RemoveListEntry(entry, reason?)
    requires: entry.status = open
    ensures:
        entry.status = removed
        entry.removed_at = now
        entry.removal_reason = reason
}

rule FiniteChecklistBecameEmpty {
    when: entry: domain/ListEntry.status transitions_to resolved | removed
    requires: entry.owner.status = active
    requires: entry.owner.behavior.owns_entries
    requires: entry.owner.behavior.lifetime = finite
    requires: entry.owner.open_entries.count = 0
    ensures: ParentReviewSuggested(parent: entry.owner)

    @guarantee EmptyFiniteChecklistRequiresOutcomeReview
        -- Resolving or intentionally removing the final entry proposes review
        -- of the finite owner; it never completes the Brick automatically.
}

-- Execution occurrences and completion-triggered repetition --------------

rule StandingExecutionStarted {
    when: StartStandingExecution(brick)
    requires: brick.status = active
    requires: brick.behavior.lifetime = standing
    requires: not exists ExecutionOccurrence{brick, status: running}
    requires: can_focus_now(brick, now)
    ensures:
        ExecutionOccurrence.created(
            id: new_id(),
            brick: brick,
            status: running,
            started_at: now)
        brick.work_state = wip
        focus.current = brick
        focus.changed_at = now
}

rule StandingExecutionFinished {
    when: FinishStandingExecution(execution, outcome, note?)
    requires: execution.status = running
    requires: execution.brick.behavior.repetition != completion_triggered
    ensures:
        execution.status = finished
        execution.finished_at = now
        execution.outcome = outcome
        execution.completion_note = note
        execution.brick.work_state = idle
        if focus.current = execution.brick:
            focus.current = null
            focus.changed_at = now

    @guarantee RunDoesNotRetireStandingWork
        -- Finishing a run never terminally completes the standing Brick.
}

rule RepeatableExecutionScheduledAgain {
    when: FinishRepeatableAndSchedule(
        execution,
        note?,
        base_delay,
        jitter_range,
        random_evidence)
    requires: execution.status = running
    requires:
        execution.brick.behavior.repetition = completion_triggered
    ensures:
        execution.status = finished
        execution.finished_at = now
        execution.outcome = done
        execution.completion_note = note
        execution.brick.work_state = idle
        execution.brick.not_before = now + deterministic_jitter(
            base_delay,
            jitter_range,
            random_evidence)
        execution.brick.date_revision =
            execution.brick.date_revision + 1
        DateConfigurationChanged(brick: execution.brick)
        if focus.current = execution.brick:
            focus.current = null
            focus.changed_at = now
        RepeatScheduled(
            brick: execution.brick,
            base_delay: base_delay,
            jitter_range: jitter_range,
            random_evidence: random_evidence,
            not_before: execution.brick.not_before)
}

rule RepeatableExecutionRetired {
    when: FinishRepeatableAndRetire(execution, note?)
    requires: execution.status = running
    requires:
        execution.brick.behavior.repetition = completion_triggered
    requires: execution.brick.active_children.count = 0
    ensures:
        execution.status = finished
        execution.finished_at = now
        execution.outcome = done
        execution.completion_note = note
        execution.brick.status = done
        execution.brick.status_changed_at = now
        execution.brick.work_state = idle
        execution.brick.not_before = null
        execution.brick.date_revision =
            execution.brick.date_revision + 1
        DateConfigurationChanged(brick: execution.brick)
        if focus.current = execution.brick:
            focus.current = null
            focus.changed_at = now
}

rule RunningExecutionAbandoned {
    when: AbandonExecution(execution, note?)
    requires: execution.status = running
    ensures:
        execution.status = abandoned
        execution.finished_at = now
        execution.outcome = abandoned
        execution.completion_note = note
        execution.brick.work_state = idle
        if focus.current = execution.brick:
            focus.current = null
            focus.changed_at = now
}

-- Recurring obligations and practices -----------------------------------

rule RecurrenceConfigured {
    when: ConfigureRecurrence(target, kind, schedule, timezone, first_release)
    requires: target.status = active
    requires:
        (kind = obligation and
            target.behavior.repetition = recurring_obligation)
        or
        (kind = practice and
            target.behavior.repetition = practice)
    requires: not exists RecurrenceRule{
        target,
        kind,
        status: active
    }
    requires: not exists RecurrenceRule{
        target,
        kind,
        status: paused
    }
    ensures: RecurrenceRule.created(
        id: new_id(),
        target: target,
        kind: kind,
        schedule: schedule,
        timezone: timezone,
        status: active,
        next_release_at: first_release,
        created_at: now)
}

rule RecurrencePaused {
    when: PauseRecurrence(recurrence)
    requires: recurrence.status = active
    ensures:
        recurrence.status = paused
        for opportunity in PracticeOpportunities
            where rule = recurrence and status = open:
            opportunity.status = not_applicable
            opportunity.resolved_at = now
            opportunity.reason = "recurrence_paused"
}

rule RecurrenceResumed {
    when: ResumeRecurrence(recurrence, next_release)
    requires: recurrence.status = paused
    ensures:
        recurrence.status = active
        recurrence.next_release_at = next_release
}

rule RecurrenceRetired {
    when: RetireRecurrence(recurrence)
    requires: recurrence.status in {active, paused}
    ensures:
        recurrence.status = retired
        for opportunity in PracticeOpportunities
            where rule = recurrence and status = open:
            opportunity.status = not_applicable
            opportunity.resolved_at = now
            opportunity.reason = "recurrence_retired"
}

rule RecurrenceScheduleRevised {
    when: ReviseRecurrence(
        recurrence,
        schedule,
        timezone,
        next_release,
        reason,
        authority)
    requires: recurrence.status in {active, paused}
    ensures:
        RecurrenceRevision.created(
            id: new_id(),
            rule: recurrence,
            prior_schedule: recurrence.schedule,
            new_schedule: schedule,
            prior_timezone: recurrence.timezone,
            new_timezone: timezone,
            next_release_at: next_release,
            reason: reason,
            authority: authority,
            revised_at: now)
        recurrence.schedule = schedule
        recurrence.timezone = timezone
        recurrence.next_release_at = next_release

    @guarantee RevisionPreservesOccurrenceHistory
        -- Schedule or method correction changes only future releases on the
        -- same semantically continuous Brick. Past opportunities, outcomes,
        -- actuals, and streak derivation are never rewritten.
}

rule DueObligationsReleased {
    when: AdvanceSchedules(at)
    for recurrence in RecurrenceRules
        where kind = obligation
        and status = active
        and next_release_at <= at:
        ensures:
            for period in due_periods(recurrence, at):
                let scope = judgment/PriorityScope{
                    parent: recurrence.target
                }
                let occurrence = domain/Brick.created(
                    id: occurrence_brick_id(recurrence, period),
                    title: occurrence_title(recurrence, period),
                    title_authority: core,
                    description_revision: 0,
                    status: active,
                    work_state: idle,
                    behavior: standard_behavior,
                    parent: recurrence.target,
                    atomicity: unknown,
                    decomposition_coverage: not_applicable,
                    not_before: occurrence_not_before(recurrence, period),
                    best_before: occurrence_best_before(recurrence, period),
                    deadline: occurrence_deadline(recurrence, period),
                    date_revision: 0,
                    created_at: now,
                    status_changed_at: now)
                judgment/PriorityScope.created(
                    id: child_scope_id(occurrence),
                    parent: occurrence,
                    members: [],
                    revision: 0)
                scope.members = provisional_insert(
                    scope.members,
                    occurrence,
                    null,
                    period)
                scope.revision = scope.revision + 1
                judgment/PriorityInsertion.created(
                    id: new_id(),
                    brick: occurrence,
                    scope: scope,
                    status: deferred,
                    comparisons_recorded: 0,
                    consecutive_skips: 0,
                    random_evidence: period,
                    started_at: now,
                    finished_at: now)
                ObligationOccurrence.created(
                    id: occurrence_identity(recurrence, period),
                    rule: recurrence,
                    period_key: period,
                    brick: occurrence,
                    released_at: now)
            recurrence.next_release_at =
                next_release_after(recurrence, at)
}

rule ApplicablePracticeOpportunitiesReleased {
    when: AdvanceSchedules(at)
    for recurrence in RecurrenceRules
        where kind = practice
        and status = active
        and next_release_at <= at
        and not brick_is_blocked(recurrence.target):
        ensures:
            for period in due_periods(recurrence, at):
                PracticeOpportunity.created(
                    id: opportunity_identity(recurrence, period),
                    rule: recurrence,
                    period_key: period,
                    status: open,
                    window_start: period_start(recurrence, period),
                    window_end: period_end(recurrence, period))
            recurrence.next_release_at =
                next_release_after(recurrence, at)
}

rule InapplicablePracticeWindowsRecorded {
    when: AdvanceSchedules(at)
    for recurrence in RecurrenceRules
        where kind = practice
        and next_release_at <= at
        and (
            status = paused
            or brick_is_blocked(recurrence.target)
        ):
        ensures:
            for period in due_periods(recurrence, at):
                PracticeOpportunity.created(
                    id: opportunity_identity(recurrence, period),
                    rule: recurrence,
                    period_key: period,
                    status: not_applicable,
                    window_start: period_start(recurrence, period),
                    window_end: period_end(recurrence, period),
                    resolved_at: now,
                    reason: inapplicable_reason(recurrence))
            recurrence.next_release_at =
                next_release_after(recurrence, at)
}

rule PracticeOpportunityCompleted {
    when: CompletePracticeOpportunity(opportunity, note?)
    requires: opportunity.status = open
    ensures:
        opportunity.status = done
        opportunity.resolved_at = now
        ExecutionOccurrence.created(
            id: new_id(),
            brick: opportunity.rule.target,
            status: finished,
            finished_at: now,
            outcome: done,
            completion_note: note)

    @guarantee PracticeCompletionDoesNotInventStart
        -- If no execution start was observed, the opportunity is done while
        -- started_at and observed duration remain unknown.
}

rule PracticeOpportunityAbandoned {
    when: AbandonPracticeOpportunity(opportunity, reason?)
    requires: opportunity.status = open
    ensures:
        opportunity.status = not_done
        opportunity.resolved_at = now
        opportunity.reason = reason

    @guarantee StreakConsequencePreviewed
        -- A capable surface shows the concrete streak consequence and asks
        -- for confirmation before submitting this terminal outcome.
}

rule ExpiredPracticeOpportunityRecorded {
    when: AdvanceSchedules(at)
    for opportunity in PracticeOpportunities
        where status = open and window_end <= at:
        ensures:
            if opportunity.rule.status = active
                and not brick_is_blocked(opportunity.rule.target):
                opportunity.status = not_done
                opportunity.reason = "window_expired"
            else:
                opportunity.status = not_applicable
                opportunity.reason = "not_applicable_at_expiry"
            opportunity.resolved_at = at
}

-- Event-triggered opportunities ------------------------------------------

rule OpportunityTriggerConfigured {
    when: ConfigureOpportunityTrigger(source, target)
    requires: source != target
    requires: source.status = active
    requires: target.status = active
    requires: target.behavior.repetition = practice
    requires: not exists OpportunityTrigger{
        source,
        target,
        status: active
    }
    ensures: OpportunityTrigger.created(
        id: new_id(),
        source: source,
        target: target,
        status: active,
        created_at: now)
}

rule SourceExecutionReleasesOpportunity {
    when: execution: ExecutionOccurrence.status transitions_to finished
    for trigger in OpportunityTriggers
        where source = execution.brick and status = active:
        requires: not exists TriggeredOpportunity{
            trigger: trigger,
            source_event_id: execution_event_id(execution)
        }
        ensures: TriggeredOpportunity.created(
            id: triggered_opportunity_id(trigger, execution),
            trigger: trigger,
            source_event_id: execution_event_id(execution),
            target: trigger.target,
            released_at: now)
}

rule DirectCompletionReleasesOpportunity {
    when: BrickCompletionRecorded(brick, note, prior_start_known)
    for trigger in OpportunityTriggers
        where source = brick and status = active:
        let source_event_id =
            current_completion_event_id(brick)
        requires: not exists TriggeredOpportunity{
            trigger: trigger,
            source_event_id: source_event_id
        }
        ensures: TriggeredOpportunity.created(
            id: triggered_opportunity_id(trigger, source_event_id),
            trigger: trigger,
            source_event_id: source_event_id,
            target: trigger.target,
            released_at: now)
}

rule TargetExecutionConsumesOneTriggeredOpportunity {
    when: execution: ExecutionOccurrence.status transitions_to finished
    let opportunity =
        earliest_unconsumed_triggered_opportunity(execution.brick)
    requires: exists opportunity
    ensures: opportunity.consumed_at = now

    @guarantee OneExecutionConsumesAtMostOneRelease
        -- Several source events may create distinct opportunities. One target
        -- execution consumes only the earliest still-open release and never
        -- fabricates source history for the others.
}

rule OpportunityTriggerRetired {
    when: RetireOpportunityTrigger(trigger)
    requires: trigger.status = active
    ensures: trigger.status = retired
}

rule TerminalBrickRetiresFutureStandingMechanics {
    when: brick: domain/Brick.status transitions_to done | dropped | superseded
    for recurrence in RecurrenceRules
        where target = brick and status in {active, paused}:
        ensures: recurrence.status = retired
    for opportunity in PracticeOpportunities
        where rule.target = brick and status = open:
        ensures:
            opportunity.status = not_applicable
            opportunity.resolved_at = now
            opportunity.reason = "target_terminal"
    for trigger in OpportunityTriggers
        where status = active
        and (
            source = brick
            or target = brick
        ):
        ensures: trigger.status = retired

    @guarantee MechanicsNeverTransferSilently
        -- Terminal standing work stops future releases. A successor keeps
        -- separate occurrence and streak history unless explicit ordinary
        -- configuration creates its own recurrence or trigger.
}

-- Date notices ------------------------------------------------------------

rule DateConfigurationChangeResolvesSupersededNotices {
    when: DateConfigurationChanged(brick)
    for notice in DateNotices
        where notice.brick in subtree(brick)
        and status in {pending, snoozed, acknowledged}:
        ensures:
            notice.status = resolved
            notice.snoozed_until = null

    @guarantee NoticeHistoryIsNotRewritten
        -- A changed local or ancestor date resolves presentation occurrences
        -- from the old effective revision. They remain audit history and the
        -- new revision may emit its own idempotent notices.
}

rule BestBeforeApproachingNoticeCreated {
    when: AdvanceTime(at)
    for brick in domain/Bricks
        where status = active
        and effective_best_before != null
        and effective_best_before > at
        and effective_best_before <=
            at + config.best_before_notice_lead:
        requires: not exists DateNotice{
            brick: brick,
            kind: best_before_approaching,
            date_value: brick.effective_best_before,
            date_revision: brick.effective_date_revision
        }
        ensures: DateNotice.created(
            id: new_id(),
            brick: brick,
            kind: best_before_approaching,
            date_value: brick.effective_best_before,
            date_revision: brick.effective_date_revision,
            status: pending,
            created_at: at)
}

rule BestBeforePassedNoticeCreated {
    when: AdvanceTime(at)
    for brick in domain/Bricks
        where status = active
        and effective_best_before != null
        and effective_best_before <= at:
        requires: not exists DateNotice{
            brick: brick,
            kind: best_before_passed,
            date_value: brick.effective_best_before,
            date_revision: brick.effective_date_revision
        }
        ensures: DateNotice.created(
            id: new_id(),
            brick: brick,
            kind: best_before_passed,
            date_value: brick.effective_best_before,
            date_revision: brick.effective_date_revision,
            status: pending,
            created_at: at)
}

rule DeadlineApproachingNoticeCreated {
    when: AdvanceTime(at)
    for brick in domain/Bricks
        where status = active
        and effective_deadline != null
        and effective_deadline > at
        and effective_deadline <= at + config.deadline_notice_lead:
        requires: not exists DateNotice{
            brick: brick,
            kind: deadline_approaching,
            date_value: brick.effective_deadline,
            date_revision: brick.effective_date_revision
        }
        ensures: DateNotice.created(
            id: new_id(),
            brick: brick,
            kind: deadline_approaching,
            date_value: brick.effective_deadline,
            date_revision: brick.effective_date_revision,
            status: pending,
            created_at: at)
}

rule DeadlineOverdueNoticeCreated {
    when: AdvanceTime(at)
    for brick in domain/Bricks
        where status = active
        and effective_deadline != null
        and effective_deadline <= at:
        requires: not exists DateNotice{
            brick: brick,
            kind: deadline_overdue,
            date_value: brick.effective_deadline,
            date_revision: brick.effective_date_revision
        }
        ensures: DateNotice.created(
            id: new_id(),
            brick: brick,
            kind: deadline_overdue,
            date_value: brick.effective_deadline,
            date_revision: brick.effective_date_revision,
            status: pending,
            created_at: at)
}

rule DateNoticeAcknowledged {
    when: AcknowledgeDateNotice(notice)
    requires: notice.status in {pending, snoozed}
    ensures: notice.status = acknowledged
}

rule DateNoticeSnoozed {
    when: SnoozeDateNotice(notice, until)
    requires: notice.status = pending
    ensures:
        notice.status = snoozed
        notice.snoozed_until = until
}

rule DateNoticeSnoozeEnded {
    when: notice: DateNotice.snoozed_until <= now
    requires: notice.status = snoozed
    ensures:
        notice.status = pending
        notice.snoozed_until = null
}

rule TerminalBrickResolvesDateNotices {
    when: terminal_brick:
        domain/Brick.status transitions_to done | dropped | superseded
    for notice in DateNotices
        where brick = terminal_brick and status != resolved:
        ensures: notice.status = resolved
}

-- Places and observations -------------------------------------------------

rule PlaceCreated {
    when: CreatePlace(label)
    ensures: Place.created(id: new_id(), label: label, created_at: now)
}

rule PlaceConditionAdded {
    when: AddPlaceCondition(brick, place, strength)
    requires: brick.status = active
    requires: not exists PlaceCondition{brick, place, strength}
    ensures: PlaceCondition.created(
        id: new_id(),
        brick: brick,
        place: place,
        strength: strength,
        created_at: now)
}

rule LocationObservationRecorded {
    when: RecordLocationObservation(
        place,
        kind,
        observed_at,
        expires_at?,
        authority,
        source,
        external_observation_id?)
    requires: external_observation_id = null
        or not exists LocationObservation{
            source: source,
            external_observation_id: external_observation_id
        }
    ensures: LocationObservation.created(
        id: observation_id(source, external_observation_id, observed_at),
        place: place,
        kind: kind,
        observed_at: observed_at,
        expires_at: if expires_at != null: expires_at
            else: observed_at + config.location_observation_ttl,
        authority: authority,
        source: source,
        external_observation_id: external_observation_id)

    @guarantee ObservationIsNotAuthorization
        -- Presence may change eligibility or pressure. It never starts,
        -- completes, skips, delegates, notifies, or reprioritizes work.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant NoSelfDependency {
    for dependency in Dependencies:
        dependency.blocked != dependency.blocker
}

invariant RootPriorityBindingIsCanonical {
    root_priority.parent = null
}

invariant StandardBehaviorBindingIsCanonical {
    standard_behavior.id = "core/standard"
}

invariant AtMostOneRunningExecutionPerBrick {
    for first in ExecutionOccurrences:
        for second in ExecutionOccurrences:
            (first.brick = second.brick
                and first.status = running
                and second.status = running)
                implies first = second
}

invariant RunningExecutionHasObservedStart {
    for execution in ExecutionOccurrences:
        execution.status = running implies execution.started_at != null
}

invariant DelegationDoesNotConsumeHumanWip {
    -- Delegation lifecycle is independent from Brick.work_state and global
    -- human focus.
    true
}

invariant DateNoticeOccurrenceIsUniquePerRevision {
    for first in DateNotices:
        for second in DateNotices:
            (
                first.brick = second.brick
                and first.kind = second.kind
                and first.date_revision = second.date_revision
            ) implies first = second
}

invariant ObligationPeriodIsUnique {
    for first in ObligationOccurrences:
        for second in ObligationOccurrences:
            (first.rule = second.rule
                and first.period_key = second.period_key)
                implies first = second
}

invariant OneLiveRecurrencePerTargetAndKind {
    for first in RecurrenceRules:
        for second in RecurrenceRules:
            (
                first.target = second.target
                and first.kind = second.kind
                and first.status in {active, paused}
                and second.status in {active, paused}
            ) implies first = second
}

invariant PracticePeriodIsUnique {
    for first in PracticeOpportunities:
        for second in PracticeOpportunities:
            (first.rule = second.rule
                and first.period_key = second.period_key)
                implies first = second
}

invariant TriggeredOpportunityIsIdempotentPerSourceEvent {
    for first in TriggeredOpportunities:
        for second in TriggeredOpportunities:
            (
                first.trigger = second.trigger
                and first.source_event_id = second.source_event_id
            ) implies first = second
}

invariant PracticeOpportunityHasValidWindow {
    for opportunity in PracticeOpportunities:
        opportunity.window_start < opportunity.window_end
}

invariant RepeatableHasAtMostOnePendingDate {
    -- Completion-triggered repetition is represented only by the same
    -- Brick's optional not_before; it never creates an occurrence backlog.
    true
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor User {
    identified_by: domain/Party where party_type = person
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface WorkDesk {
    facing user: User

    exposes:
        user.id
        focus.current

    provides:
        RenameBrick(brick, title, authority)
        SetBrickOriginalTitle(brick, original_title)
        ClearBrickOriginalTitle(brick)
        DescribeBrick(brick, description)
        ClearBrickDescription(brick)
        SetBrickPhase(brick, phase, authority)
        ClearBrickPhase(brick)
        SetBrickContext(brick, context)
        ClearBrickContext(brick)
        SetBrickMode(brick, mode)
        ClearBrickMode(brick)
        SetBrickNotBefore(brick, value)
        ClearBrickNotBefore(brick)
        SetBrickBestBefore(brick, value)
        ClearBrickBestBefore(brick)
        SetBrickDeadline(brick, value)
        ClearBrickDeadline(brick)
        SetBrickRequester(brick, requester)
        ClearBrickRequester(brick)
        SetBrickAbout(brick, about)
        ClearBrickAbout(brick)
        FocusBrick(brick)
        UnfocusCurrentBrick()
        ReturnBrickToIdle(brick)
        CompleteBrick(brick, note?)
        RetireStandingBrick(brick, note?)
        DropBrick(brick, reason?)
        SupersedeBrick(brick, replacement, reason?)
        SupersedeBrickWithChildren(
            brick,
            replacement,
            selected_children,
            reason?)
        CompleteSubtree(root, note?)
        DropSubtree(root, reason?)
        MoveSubtreeUnderParent(root, new_parent)
        MoveSubtreeToRoot(root)
        AddWait(brick, on_party?, condition)
        ResolveWait(wait)
        CancelWait(wait)
        AddDependency(blocked, blocker)
        CancelDependency(dependency)
        DelegateBrick(brick, delegate, instructions, next_followup_at?)
        ApproveDelegationNotice(delegation)
        MarkDelegationInProgress(delegation)
        MarkDelegationCompleted(delegation, result_note?)
        MarkDelegationRefused(delegation, result_note?)
        AbandonDelegation(delegation, result_note?)
        SkipServedBrick(brick, reason, raw_text?)
        AddListEntry(owner, label, original_label?, authority, quantity?, note?)
        ResolveListEntry(entry)
        RemoveListEntry(entry, reason?)
        StartStandingExecution(brick)
        FinishStandingExecution(execution, outcome, note?)
        FinishRepeatableAndSchedule(
            execution,
            note?,
            base_delay,
            jitter_range,
            random_evidence)
        FinishRepeatableAndRetire(execution, note?)
        AbandonExecution(execution, note?)
        ConfigureRecurrence(target, kind, schedule, timezone, first_release)
        PauseRecurrence(recurrence)
        ResumeRecurrence(recurrence, next_release)
        RetireRecurrence(recurrence)
        ReviseRecurrence(
            recurrence,
            schedule,
            timezone,
            next_release,
            reason,
            authority)
        CompletePracticeOpportunity(opportunity, note?)
        AbandonPracticeOpportunity(opportunity, reason?)
        ConfigureOpportunityTrigger(source, target)
        RetireOpportunityTrigger(trigger)
        AcknowledgeDateNotice(notice)
        SnoozeDateNotice(notice, until)
        CreatePlace(label)
        AddPlaceCondition(brick, place, strength)
        RecordLocationObservation(
            place,
            kind,
            observed_at,
            expires_at?,
            authority,
            source,
            external_observation_id?)

    contracts:
        fulfils PracticeProjection

    @guarantee DirectDoneIsAlwaysVisible
        -- A served finite Brick exposes done separately from start and skip,
        -- even when no prior start evidence exists.

    @guarantee StandingRunAndRetirementAreDistinct
        -- Finishing an execution and retiring a standing responsibility are
        -- separate explicit actions.
}

surface DeterministicClock {
    provides:
        AdvanceTime(at)
        AdvanceSchedules(at)

    @guarantee ReplaySafeTime
        -- Rules consume an explicit instant. Replaying history never reads a
        -- new wall-clock value or produces a second occurrence for one key.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Calendar arithmetic, timezone changes, and daylight-saving resolution require explicit implementation policy."
open question "Initial served-skip cooldowns and adaptive practice-review thresholds are inspectable calibration, not fixed semantics."
