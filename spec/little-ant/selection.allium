-- allium: 3
-- Little Ant 1.0 — forecast, next, proposals, pressure, and capture review.

use "./domain.allium" as domain
use "./material.allium" as material
use "./judgment.allium" as judgment
use "./execution.allium" as execution

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    focus: domain/FocusRegister
    root_priority: judgment/PriorityScope
    standard_behavior: domain/BrickBehavior
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value ForecastItem {
    brick: domain/Brick?
    proposal: Proposal?
    weight: Decimal
    probability: Decimal
    reasons: List<String>
}

value ForecastView {
    domain_revision: Integer
    generated_at: Timestamp
    items: List<ForecastItem>
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract ForecastEngine {
    build: (at: Timestamp, domain_revision: Integer) -> ForecastView

    @invariant ReadOnlyForecast
        -- Building or rendering a forecast consumes no randomness and changes
        -- no canonical state.

    @invariant ExplainableWeight
        -- Every non-zero contribution is named in the candidate's reasons.

    @invariant PositiveEligibleChance
        -- Every ordinary eligible candidate has positive probability.

    @invariant PriorityIsNotRewritten
        -- Forecast never changes PriorityScope.members.

    @invariant EligibilityUsesEffectiveMetadata
        -- Context, mode, not_before, best_before, and deadline are read through
        -- their effective inherited projections. A child cannot bypass an
        -- ancestor constraint by leaving its local field empty.

    @invariant DormantStandingWorkIsNotExecutable
        -- An empty behavior configured as derivatively dormant remains active
        -- and retains identity and history, but receives no ordinary execution
        -- probability until new child or entry work appears.

    @invariant PriorityContributesWithoutBecomingForecast
        -- A stronger human priority path contributes selection pressure, but
        -- forecast also explains eligibility, current focus, phase when
        -- applicable, dates, dependencies, place conditions, aging, skips,
        -- unresolved reviews, and recurrence opportunities.

    @invariant BlockersChangeEligibilityNotImportance
        -- A blocked Brick retains its human priority and receives no ordinary
        -- execution chance. Its blocker may gain explainable pressure because
        -- resolving it unlocks important work.

    @invariant MissingOptionalAxesAreNeutral
        -- Absence of phase, impact, or effort contributes neither a penalty
        -- nor an eligibility failure. Those axes are consulted lazily only
        -- when present, applicable, and useful.

    @invariant TriggeredOpportunitiesAreExplicitPressure
        -- An unconsumed event-triggered opportunity may make its existing
        -- standing target selectable. It never creates, resurrects, starts,
        -- completes, or reprioritizes that Brick.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ProposalKind {
    priority_probe |
    impact_probe |
    effort_probe |
    brick_review |
    review_parent |
    review_wip |
    phase_review |
    practice_review |
    review_raw |
    refresh_raw |
    stale_focus |
    stale_comparison |
    scope_review |
    source_reconciliation |
    delegation_followup |
    effect_approval |
    duplicate_review |
    place_batch |
    investigation_plan
}
enum ProposalStatus { open | resolved | dismissed }
enum CaptureRoute {
    preserve_raw |
    create_brick |
    create_list_entry |
    instantiate_template |
    enrich_existing
}
enum CaptureStatus { pending_review | routed | cancelled }
enum DuplicateTargetKind { brick | list_entry | raw }
enum DuplicateDecisionKind { reuse | enrich | separate }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Proposal {
    id: String
    kind: ProposalKind
    brick: domain/Brick?
    raw: material/Raw?
    insertion: judgment/PriorityInsertion?
    judgment_probe: judgment/JudgmentProbe?
    delegation: execution/Delegation?
    reason: String
    status: ProposalStatus
    created_at: Timestamp
    available_at: Timestamp

    transitions status {
        open -> resolved
        open -> dismissed
        terminal: resolved, dismissed
    }
}

entity SelectionCooldown {
    id: String
    brick: domain/Brick
    until: Timestamp
    recent_skip_count: Integer
    last_reason: execution/SkipReason
}

entity NextDraw {
    id: String
    selected_brick: domain/Brick?
    selected_proposal: Proposal?
    domain_revision: Integer
    random_evidence: String
    drawn_at: Timestamp
    reasons: List<String>

    source_forecast: ForecastView =
        forecast_at(domain_revision, drawn_at)
}

entity CaptureIntent {
    id: String
    original_text: String
    canonical_english: String?
    normalization_authority: domain/Authority?
    proposed_route: CaptureRoute?
    proposed_parent: domain/Brick?
    proposed_owner: domain/Brick?
    proposed_behavior: domain/BrickBehavior?
    proposed_template: domain/BrickTemplate?
    status: CaptureStatus
    created_at: Timestamp

    transitions status {
        pending_review -> routed
        pending_review -> cancelled
        terminal: routed, cancelled
    }
}

entity DuplicateSuspicion {
    id: String
    capture: CaptureIntent
    target_kind: DuplicateTargetKind
    target_brick: domain/Brick?
    target_entry: domain/ListEntry?
    target_raw: material/Raw?
    strength: Decimal
    reasons: List<String>

    match_view: DuplicateMatch = duplicate_match_view(this)
}

entity DuplicateDecision {
    id: String
    capture: CaptureIntent
    suspicion: DuplicateSuspicion?
    decision: DuplicateDecisionKind
    authority: domain/Authority
    recorded_at: Timestamp
}

value DuplicateMatch {
    target_kind: DuplicateTargetKind
    target_brick: domain/Brick?
    target_entry: domain/ListEntry?
    target_raw: material/Raw?
    strength: Decimal
    reasons: List<String>
}

contract DuplicateMatcher {
    rank: (capture: CaptureIntent) -> List<DuplicateMatch>

    @invariant StableExternalIdentityFirst
        -- A known adapter/account/external-ID tuple resolves its prior capture
        -- before semantic similarity is considered.

    @invariant BoundedLayeredEvidence
        -- Matching is bounded and layered over canonical English fingerprints,
        -- compatible target kind, parent or owner scope, active and terminal
        -- history, recurrence period, and attributed semantic evidence.

    @invariant FingerprintsAreRebuildable
        -- Normalized text, token, and similarity fingerprints are projections,
        -- never persisted entity identity or global aliases.

    @invariant SuspicionNeverMutates
        -- Rank and strength only decide which explicit alternatives to show.
        -- No threshold silently merges, drops, archives, redirects, or
        -- discards the submitted input.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    served_skip_cooldown: Duration = 2.hours
    stale_focus_after: Duration = 24.hours
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Proposal materialization ------------------------------------------------

rule DeferredPlacementCreatesPriorityProbe {
    when: insertion: judgment/PriorityInsertion.status transitions_to deferred
    requires: not exists Proposal{
        kind: priority_probe,
        insertion: insertion,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: priority_probe,
        brick: insertion.brick,
        insertion: insertion,
        reason: "priority placement is provisional",
        status: open,
        created_at: now,
        available_at: now)
}

rule DeferredPriorityMayProposeInvestigationWork {
    when: insertion: judgment/PriorityInsertion.status transitions_to deferred
    requires: expected_value_of_priority_information(insertion) = high
    requires: not exists Proposal{
        kind: investigation_plan,
        insertion: insertion,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: investigation_plan,
        brick: insertion.brick,
        insertion: insertion,
        reason:
            "resolving this importance uncertainty could change a relevant decision",
        status: open,
        created_at: now,
        available_at: now)
}

rule ContradictionCreatesPriorityProbe {
    when: recalibration: judgment/PriorityRecalibration.created
    requires: not exists Proposal{
        kind: priority_probe,
        brick: recalibration.segment.first,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: priority_probe,
        brick: recalibration.segment.first,
        reason: "a local priority segment contradicts current evidence",
        status: open,
        created_at: now,
        available_at: now)
}

rule JudgmentProbeCreatesAxisProposal {
    when: probe: judgment/JudgmentProbe.created
    requires: not exists Proposal{
        judgment_probe: probe,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: proposal_kind_for_axis(probe.axis),
        brick: probe.left,
        judgment_probe: probe,
        reason: probe.reason,
        status: open,
        created_at: now,
        available_at: now)
}

rule DueProvocativeValidationOpened {
    when: AdvanceSelection(at)
    let candidate = due_provocative_validation(at)
    requires: candidate != null
    requires: validation_candidate_is_comparable(candidate)
    requires: not exists judgment/JudgmentProbe{
        axis: candidate.axis,
        left: candidate.left,
        right: candidate.right,
        status: open
    }
    ensures: judgment/JudgmentProbe.created(
        id: new_id(),
        axis: candidate.axis,
        purpose: validation,
        scope: candidate.scope,
        left: candidate.left,
        right: candidate.right,
        reason: candidate.reason,
        status: open,
        created_at: at)

    @guarantee ValidationIsProvocativeButBounded
        -- The deterministic core occasionally tests one direct relation
        -- implied by retained priority, impact, or effort history. Recency,
        -- reversals, contradictions, and structural change raise pressure;
        -- optional-axis absence never creates mandatory classification.
}

rule ReopenedJudgmentProbeCreatesAxisProposal {
    when: probe: judgment/JudgmentProbe.status transitions_to open
    requires: not exists Proposal{
        judgment_probe: probe,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: proposal_kind_for_axis(probe.axis),
        brick: probe.left,
        judgment_probe: probe,
        reason: probe.reason,
        status: open,
        created_at: now,
        available_at: now)
}

rule DeferredJudgmentProbeResolvesAxisProposal {
    when: probe: judgment/JudgmentProbe.status transitions_to deferred
    for proposal in Proposals
        where judgment_probe = probe and status = open:
        ensures: proposal.status = resolved
}

rule DeferredJudgmentMayProposeInvestigationWork {
    when: probe: judgment/JudgmentProbe.status transitions_to deferred
    requires: expected_value_of_judgment_information(probe) = high
    requires: not exists Proposal{
        kind: investigation_plan,
        judgment_probe: probe,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: investigation_plan,
        brick: probe.left,
        judgment_probe: probe,
        reason:
            "purposeful evidence could resolve a decision-relevant uncertainty",
        status: open,
        created_at: now,
        available_at: now)

    @guarantee InvestigationIsProposedWorkNotEmbeddedValidation
        -- The proposal may route through ordinary capture to a questionnaire,
        -- research task, meeting, POC, MVP, experiment, or other Brick. The
        -- core never invents the method, creates it silently, or changes the
        -- target judgment when that Brick finishes.
}

rule ResolvedJudgmentProbeResolvesAxisProposal {
    when: probe: judgment/JudgmentProbe.status transitions_to resolved
    for proposal in Proposals
        where judgment_probe = probe and status = open:
        ensures: proposal.status = resolved
}

rule ParentReviewProposed {
    when: execution/ParentReviewSuggested(parent)
    requires: not exists Proposal{
        kind: review_parent,
        brick: parent,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: review_parent,
        brick: parent,
        reason: "the final active child closed",
        status: open,
        created_at: now,
        available_at: now)
}

rule WipReviewProposed {
    when: execution/WipReviewSuggested(brick)
    requires: not exists Proposal{
        kind: review_wip,
        brick: brick,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: review_wip,
        brick: brick,
        reason: "the soft human WIP limit was exceeded",
        status: open,
        created_at: now,
        available_at: now)
}

rule ScopeReviewProposed {
    when: execution/ScopeReviewSuggested(brick, reason)
    requires: not exists Proposal{
        kind: scope_review,
        brick: brick,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: scope_review,
        brick: brick,
        reason: reason,
        status: open,
        created_at: now,
        available_at: now)
}

rule DependencyReviewProposed {
    when: execution/DependencyReviewSuggested(blocked)
    requires: not exists Proposal{
        kind: brick_review,
        brick: blocked,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: brick_review,
        brick: blocked,
        reason: "a blocker ended without satisfying the dependency",
        status: open,
        created_at: now,
        available_at: now)
}

rule NewRawCreatesReviewProposal {
    when: raw: material/Raw.created
    requires: raw.review_state = pending
    requires: raw.storage_state = active
    requires: not exists Proposal{
        kind: review_raw,
        raw: raw,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: review_raw,
        raw: raw,
        reason: "new material has not been reviewed",
        status: open,
        created_at: now,
        available_at: now)
}

rule ReviewedRawResolvesReviewProposal {
    when: reviewed_raw:
        material/Raw.review_state transitions_to reviewed
    for proposal in Proposals
        where raw = reviewed_raw
        and kind = review_raw
        and status = open:
        ensures: proposal.status = resolved
}

rule ArchivedRawResolvesMaterialProposals {
    when: archived_raw:
        material/Raw.storage_state transitions_to archived
    for proposal in Proposals
        where raw = archived_raw and status = open:
        ensures: proposal.status = resolved
}

rule SourceRefreshCreatesReconciliationProposal {
    when: snapshot: material/RawSnapshot.created
    for link in material/RawLinks
        where raw = snapshot.raw
        and role = source
        and reconciled_snapshot != snapshot:
        requires: not exists Proposal{
            kind: source_reconciliation,
            brick: source_link_owner_brick(link),
            status: open
        }
        ensures: Proposal.created(
            id: new_id(),
            kind: source_reconciliation,
            brick: source_link_owner_brick(link),
            raw: snapshot.raw,
            reason: "a linked source has a newer attributable snapshot",
            status: open,
            created_at: now,
            available_at: now)
}

rule ProposalResolved {
    when: ResolveProposal(proposal)
    requires: proposal.status = open
    requires:
        proposal.kind not in {priority_probe, impact_probe, effort_probe}
        or proposal.judgment_probe = null
    ensures: proposal.status = resolved
}

rule ProposalDismissed {
    when: DismissProposal(proposal)
    requires: proposal.status = open
    ensures:
        proposal.status = dismissed
        if proposal.judgment_probe != null
            and proposal.judgment_probe.status = open:
            proposal.judgment_probe.status = deferred
}

-- Served skip cooldown and retained pressure ------------------------------

rule FirstServedSkipStartsCooldown {
    when: execution/ServedSkipRecorded(brick, reason)
    requires: not exists SelectionCooldown{brick}
    ensures: SelectionCooldown.created(
        id: new_id(),
        brick: brick,
        until: now + config.served_skip_cooldown,
        recent_skip_count: 1,
        last_reason: reason)
}

rule RepeatedServedSkipRefreshesCooldown {
    when: execution/ServedSkipRecorded(brick, reason)
    let cooldown = SelectionCooldown{brick}
    requires: exists cooldown
    ensures:
        cooldown.until = now + config.served_skip_cooldown
        cooldown.recent_skip_count =
            cooldown.recent_skip_count + 1
        cooldown.last_reason = reason
}

rule RepeatedPracticeFrictionCreatesReview {
    when: execution/ServedSkipRecorded(brick, reason)
    requires: brick.behavior.repetition = practice
    requires: practice_review_due(brick)
    requires: not exists Proposal{
        kind: practice_review,
        brick: brick,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: practice_review,
        brick: brick,
        reason:
            "repeated practice friction may indicate a blocker, schedule mismatch, or unsuitable method",
        status: open,
        created_at: now,
        available_at: now)
}

rule RepeatedUnfulfilledPracticeCreatesReview {
    when: opportunity:
        execution/PracticeOpportunity.status transitions_to not_done
    requires: practice_review_due(opportunity.rule.target)
    requires: not exists Proposal{
        kind: practice_review,
        brick: opportunity.rule.target,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: practice_review,
        brick: opportunity.rule.target,
        reason:
            "repeated unfulfilled opportunities merit an enabling-work or cadence review",
        status: open,
        created_at: now,
        available_at: now)

    @guarantee ReviewDoesNotInventCause
        -- The core exposes outcomes, repeated reasons, timing, blockers, and
        -- streak consequences. A human or attributed operator interprets why
        -- and may explicitly propose ordinary enabling Bricks.
}

-- Stale focus -------------------------------------------------------------

rule StaleFocusProposed {
    when: AdvanceSelection(at)
    requires: focus.current != null
    requires: focus.changed_at != null
    requires: focus.changed_at + config.stale_focus_after <= at
    requires: not exists Proposal{
        kind: stale_focus,
        brick: focus.current,
        status: open
    }
    ensures: Proposal.created(
        id: new_id(),
        kind: stale_focus,
        brick: focus.current,
        reason: "current focus has not been reaffirmed",
        status: open,
        created_at: at,
        available_at: at)
}

-- Forecast and next -------------------------------------------------------

rule ValidCurrentFocusReturnedByNext {
    when: RequestNext(at, domain_revision, random_evidence)
    requires: focus.current != null
    requires: executable_candidate(focus.current, at)
    ensures: NextDraw.created(
        id: new_id(),
        selected_brick: focus.current,
        domain_revision: domain_revision,
        random_evidence: random_evidence,
        drawn_at: at,
        reasons: ["current focus remains valid"])
}

rule OrdinaryNextDrawnFromForecast {
    when: RequestNext(at, domain_revision, random_evidence)
    requires: focus.current = null
        or not executable_candidate(focus.current, at)
    let forecast = build_forecast(at, domain_revision)
    requires: forecast.items.count > 0
    ensures:
        let selected = replay_safe_weighted_draw(
            forecast.items,
            random_evidence)
        NextDraw.created(
            id: new_id(),
            selected_brick: selected.brick,
            selected_proposal: selected.proposal,
            domain_revision: domain_revision,
            random_evidence: random_evidence,
            drawn_at: at,
            reasons: selected.reasons)

    @guarantee DrawDoesNotBecomePriority
        -- The selected action and random evidence are historical facts. They
        -- do not create a stored forecast order or move a PriorityScope.
}

-- Capture and duplicate suspicion ----------------------------------------

rule CaptureIntentOpened {
    when: BeginCapture(
        original_text,
        canonical_english?,
        normalization_authority?,
        proposed_route?,
        proposed_parent?,
        proposed_owner?,
        proposed_behavior?,
        proposed_template?)
    requires:
        (canonical_english = null
            and normalization_authority = null)
        or
        (canonical_english != null
            and normalization_authority != null)
    ensures: CaptureIntent.created(
        id: new_id(),
        original_text: original_text,
        canonical_english: canonical_english,
        normalization_authority: normalization_authority,
        proposed_route: proposed_route,
        proposed_parent: proposed_parent,
        proposed_owner: proposed_owner,
        proposed_behavior: proposed_behavior,
        proposed_template: proposed_template,
        status: pending_review,
        created_at: now)
}

rule DeterministicDuplicateSuspicionsGenerated {
    when: capture: CaptureIntent.created
    for candidate in deterministic_duplicate_candidates(capture):
        ensures: DuplicateSuspicion.created(
            id: new_id(),
            capture: capture,
            target_kind: candidate.kind,
            target_brick: candidate.brick,
            target_entry: candidate.entry,
            target_raw: candidate.raw,
            strength: candidate.strength,
            reasons: candidate.reasons)
}

rule DuplicateReuseConfirmed {
    when: ConfirmDuplicateDecision(
        capture,
        suspicion,
        decision,
        authority)
    requires: capture.status = pending_review
    requires: suspicion.capture = capture
    requires: decision in {reuse, enrich}
    ensures:
        DuplicateDecision.created(
            id: new_id(),
            capture: capture,
            suspicion: suspicion,
            decision: decision,
            authority: authority,
            recorded_at: now)
        capture.status = routed
        CaptureRouted(
            capture: capture,
            route: enrich_existing,
            suspicion: suspicion)
}

rule SeparateCaptureConfirmed {
    when: ConfirmSeparateCapture(capture, authority)
    requires: capture.status = pending_review
    requires: capture.proposed_route != null
    requires: capture.proposed_route != enrich_existing
    requires:
        capture.proposed_route not in {
            create_brick,
            create_list_entry,
            instantiate_template
        }
        or (
            resolved_capture_english(capture) != null
            and resolved_capture_authority(capture) != null
        )
    ensures:
        DuplicateDecision.created(
            id: new_id(),
            capture: capture,
            decision: separate,
            authority: authority,
            recorded_at: now)
        capture.status = routed
        CaptureRouted(
            capture: capture,
            route: capture.proposed_route,
            suspicion: null)

    @guarantee SuspicionIsNotIdentity
        -- Similarity never merges, deletes, aliases, or redirects canonical
        -- identity without an explicit attributed decision.
}

rule CaptureCancelled {
    when: CancelCapture(capture)
    requires: capture.status = pending_review
    ensures: capture.status = cancelled
}

-- Confirmed capture materialization --------------------------------------

rule ConfirmedCapturePreservedAsRaw {
    when: CaptureRouted(capture, preserve_raw, suspicion)
    ensures: material/Raw.created(
        id: new_id(),
        title: capture.canonical_english,
        original_text: capture.original_text,
        canonical_english: capture.canonical_english,
        normalization_authority: capture.normalization_authority,
        review_state: pending,
        storage_state: active,
        created_at: now)
}

rule ConfirmedCaptureCreatesPositionedBrick {
    when: CaptureRouted(capture, route, suspicion)
    requires: route in {create_brick, instantiate_template}
    requires: resolved_capture_english(capture) != null
    requires: resolved_capture_authority(capture) != null
    requires:
        canonical_english_text(resolved_capture_english(capture))
    requires:
        route != instantiate_template
        or capture.proposed_template != null
    requires:
        capture.proposed_parent = null
        or capture.proposed_parent.status = active
    let parent = capture.proposed_parent
    let scope = priority_scope_for(parent, root_priority)
    let was_empty = scope.members.count = 0
    let behavior =
        if route = instantiate_template:
            capture.proposed_template.behavior
        else if capture.proposed_behavior != null:
            capture.proposed_behavior
        else:
            standard_behavior
    ensures:
        let brick = domain/Brick.created(
            id: new_id(),
            title: resolved_capture_english(capture),
            original_title: capture.original_text,
            title_authority: resolved_capture_authority(capture),
            description:
                if route = instantiate_template:
                    capture.proposed_template.default_description
                else: null,
            description_revision:
                if route = instantiate_template
                    and capture.proposed_template.default_description != null:
                    1
                else: 0,
            status: active,
            work_state: idle,
            behavior: behavior,
            parent: parent,
            atomicity: unknown,
            date_revision: 0,
            decomposition_coverage: not_applicable,
            created_at: now,
            status_changed_at: now)
        judgment/PriorityScope.created(
            id: child_scope_id(brick),
            parent: brick,
            members: [],
            revision: 0)
        scope.members = provisional_insert(
            scope.members,
            brick,
            null,
            capture.id)
        scope.revision = scope.revision + 1
        if parent != null:
            parent.decomposition_coverage = open
        judgment/PriorityInsertion.created(
            id: new_id(),
            brick: brick,
            scope: scope,
            status: if was_empty: resolved else: open,
            current_candidate:
                if was_empty: null
                else: binary_insertion_candidate(scope.members, brick),
            comparisons_recorded: 0,
            consecutive_skips: 0,
            random_evidence: capture.id,
            started_at: now,
            finished_at: if was_empty: now else: null)

    @guarantee WorkExistsOnlyAfterCanonicalRouting
        -- The confirmed route creates one active Brick already occupying one
        -- strict sibling position. The original title remains provenance; no
        -- title-derived identity or unpositioned intermediate state exists.
}

rule ConfirmedCaptureCreatesListEntry {
    when: CaptureRouted(capture, create_list_entry, suspicion)
    requires: capture.proposed_owner != null
    requires: capture.proposed_owner.status = active
    requires: capture.proposed_owner.behavior.owns_entries
    requires: capture.canonical_english != null
    requires: capture.normalization_authority != null
    requires: canonical_english_text(capture.canonical_english)
    ensures: domain/ListEntry.created(
        id: new_id(),
        owner: capture.proposed_owner,
        label: capture.canonical_english,
        original_label: capture.original_text,
        label_authority: capture.normalization_authority,
        status: open,
        created_at: now)

    @guarantee EntryUsesOwnerSemantics
        -- The owner remains the focus and priority unit; the entry gains no
        -- independent phase, effort, WIP, position, or next eligibility.
}

rule ConfirmedDuplicateEnrichesWithoutIdentityMerge {
    when: CaptureRouted(capture, enrich_existing, suspicion)
    requires: suspicion != null
    requires: suspicion.capture = capture
    let decision = DuplicateDecision{capture, suspicion}
    ensures:
        let raw = material/Raw.created(
            id: new_id(),
            title: capture.canonical_english,
            original_text: capture.original_text,
            canonical_english: capture.canonical_english,
            normalization_authority: capture.normalization_authority,
            review_state: reviewed,
            storage_state: active,
            created_at: now)
        if suspicion.target_brick != null:
            material/RawLink.created(
                id: new_id(),
                raw: raw,
                role: evidence,
                owner_brick: suspicion.target_brick,
                created_at: now)
        if suspicion.target_entry != null:
            material/RawLink.created(
                id: new_id(),
                raw: raw,
                role: evidence,
                owner_entry: suspicion.target_entry,
                created_at: now)
        if suspicion.target_raw != null:
            material/RawLink.created(
                id: new_id(),
                raw: suspicion.target_raw,
                role: derived_from,
                owner_raw: raw,
                created_at: now)
        material/RawReviewDisposition.created(
            id: new_id(),
            raw: raw,
            kind: linked,
            brick: duplicate_target_owner_brick(suspicion),
            recorded_at: now,
            authority: decision.authority,
            note: duplicate_decision_note(decision))

    @guarantee DuplicateDecisionPreservesInputAndIdentity
        -- Reuse or enrich preserves the submitted material and links it to
        -- the confirmed target. It never aliases IDs, redirects future
        -- commands, deletes either entity, or derives identity from text.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant NextDrawSelectsExactlyOneKind {
    for draw in NextDraws:
        (draw.selected_brick != null or draw.selected_proposal != null)
        and not (
            draw.selected_brick != null
            and draw.selected_proposal != null
        )
}

invariant ProposalIsNotBrick {
    -- Proposal has no parent, phase, priority position, effort, WIP, or
    -- terminal Brick event. It is a derived maintenance opportunity.
    true
}

invariant DuplicateSuspicionHasOneTarget {
    for suspicion in DuplicateSuspicions:
        (
            suspicion.target_brick != null
            or suspicion.target_entry != null
            or suspicion.target_raw != null
        )
        and not (
            suspicion.target_brick != null
            and suspicion.target_entry != null
        )
        and not (
            suspicion.target_brick != null
            and suspicion.target_raw != null
        )
        and not (
            suspicion.target_entry != null
            and suspicion.target_raw != null
        )
}

invariant OneDuplicateDecisionPerCapture {
    for first in DuplicateDecisions:
        for second in DuplicateDecisions:
            first.capture = second.capture implies first = second
}

invariant CaptureBindingsAreCanonical {
    root_priority.parent = null
    and standard_behavior.id = "core/standard"
}

invariant OptionalAxesDoNotControlEligibility {
    -- Missing phase, impact, or effort alone never makes active work
    -- ineligible. Applicability, dates, waits, dependencies, place
    -- requirements, and behavior may do so.
    true
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor User {
    identified_by: domain/Party where party_type = person
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface SelectionDesk {
    facing user: User

    exposes:
        user.id
        focus.current

    provides:
        BuildForecast(at, domain_revision)
        RequestNext(at, domain_revision, random_evidence)
        ResolveProposal(proposal)
        DismissProposal(proposal)
        AdvanceSelection(at)
        BeginCapture(
            original_text,
            canonical_english?,
            normalization_authority?,
            proposed_route?,
            proposed_parent?,
            proposed_owner?,
            proposed_behavior?,
            proposed_template?)
        ConfirmDuplicateDecision(
            capture,
            suspicion,
            decision,
            authority)
        ConfirmSeparateCapture(capture, authority)
        CancelCapture(capture)

    contracts:
        fulfils ForecastEngine
        fulfils DuplicateMatcher

    @guarantee PriorityAndForecastAreSeparate
        -- Priority is the persistent human hierarchy. Forecast is a read-only
        -- distribution over currently useful actions.

    @guarantee DeterministicPrecedence
        -- Valid focus, stale-focus resolution, pending approvals, and overdue
        -- follow-ups are considered before the ordinary weighted lottery.

    @guarantee ProgressiveExplanation
        -- A compact view gives weights and reasons; focused projections expose
        -- deeper evidence without requiring full entities or event history.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Initial forecast weights, aging curves, pressure thresholds, and cooldown adaptation remain versioned inspectable calibration."
