-- allium: 3
-- Little Ant 1.0 — shared domain vocabulary.
-- Product-owned words, identifiers, commands, prompts, and responses are
-- canonical English. Persisted entity identity is opaque and never derived
-- from a mutable title or label.

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Authority { human | ai | adapter | core }
enum PartyType { person | ai_agent | company | area }
enum BrickStatus { active | done | dropped | superseded }
enum BrickPhase { idea | spec | exec | validation }
enum WorkState { idle | wip }
enum Atomicity { atomic | divisible | unknown }
enum Mode { digital | physical | hybrid | any }
enum DecompositionCoverage { not_applicable | open | complete }
enum FocusUnit { brick | children | batch }
enum Lifetime { finite | standing }
enum Applicability { applicable | disabled }
enum RepetitionKind {
    none |
    completion_triggered |
    recurring_obligation |
    practice
}
enum ListEntryStatus { open | resolved | removed }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Party {
    id: String
    label: String
    party_type: PartyType
    alternate_labels: List<String>
    created_at: Timestamp
}

entity BrickBehavior {
    id: String
    namespace: String
    version: Integer
    focus_unit: FocusUnit
    lifetime: Lifetime
    owns_entries: Boolean
    renders_all_open_entries: Boolean
    empty_is_dormant: Boolean
    phase: Applicability
    effort: Applicability
    repetition: RepetitionKind
}

entity BrickTemplate {
    id: String
    namespace: String
    version: Integer
    display_name: String
    category: String
    purpose: String
    search_terms: List<String>
    behavior: BrickBehavior
    default_title: String?
    default_description: String?
}

entity Brick {
    id: String
    title: String
    original_title: String?
    title_authority: Authority
    description: String?
    description_revision: Integer
    status: BrickStatus
    phase: BrickPhase?
    phase_authority: Authority?
    work_state: WorkState
    behavior: BrickBehavior
    parent: Brick?
    atomicity: Atomicity
    context: String?
    mode: Mode?
    about: Brick?
    requester: Party?
    not_before: Timestamp?
    best_before: Timestamp?
    deadline: Timestamp?
    date_revision: Integer
    decomposition_coverage: DecompositionCoverage
    created_at: Timestamp
    status_changed_at: Timestamp
    superseded_by: Brick when status = superseded
    supersede_reason: String? when status = superseded

    transitions status {
        active -> done
        active -> dropped
        active -> superseded
        terminal: done, dropped, superseded
    }

    transitions work_state {
        idle -> wip
        wip -> idle
    }

    children: Brick with parent = this
    active_children: children where status = active
    entries: ListEntry with owner = this
    open_entries: entries where status = open

    is_active: status = active
    has_active_children: active_children.count > 0
    is_dormant: Boolean = derived_behavior_dormancy(this)
    phase_is_applicable: behavior.phase = applicable
    effort_is_applicable: behavior.effort = applicable
    effective_context: String? = nearest_context(this)
    effective_mode: Mode? = nearest_mode(this)
    effective_not_before: Timestamp? =
        latest_ancestor_not_before(this)
    effective_best_before: Timestamp? =
        earliest_ancestor_best_before(this)
    effective_deadline: Timestamp? =
        earliest_ancestor_deadline(this)
    effective_date_revision: String =
        ancestor_date_revision_fingerprint(this)
}

entity ListEntry {
    id: String
    owner: Brick
    label: String
    original_label: String?
    label_authority: Authority
    quantity: Decimal?
    note: String?
    status: ListEntryStatus
    created_at: Timestamp
    resolved_at: Timestamp when status = resolved
    removed_at: Timestamp when status = removed
    removal_reason: String? when status = removed

    transitions status {
        open -> resolved
        open -> removed
        terminal: resolved, removed
    }
}

entity FocusRegister {
    current: Brick?
    changed_at: Timestamp?
}

------------------------------------------------------------
-- Definition catalog contract
------------------------------------------------------------

contract DefinitionCatalog {
    find_behaviors: (
        query: String,
        cursor: String?,
        page_size: Integer
    ) -> List<BrickBehavior>
    find_templates: (
        query: String,
        category: String?,
        cursor: String?,
        page_size: Integer
    ) -> List<BrickTemplate>

    @invariant BoundedInspectableResults
        -- Catalog retrieval is searchable, categorized, paginated, and
        -- bounded. Every candidate returns its exact namespace, version,
        -- resolved behavior, and deterministic discovery metadata.

    @invariant NoRuntimeAuthority
        -- Retrieval rank and template metadata help discovery only. A
        -- confirmed expansion uses the definition's explicit fields and
        -- never executes hidden domain logic.
}

