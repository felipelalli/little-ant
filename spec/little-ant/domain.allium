------------------------------------------------------------
-- Personal definition rules
------------------------------------------------------------

rule PartyCreated {
    when: CreateParty(label, party_type)
    ensures: Party.created(
        id: new_id(),
        label: label,
        party_type: party_type,
        alternate_labels: [],
        created_at: now)
}

rule PartyRenamed {
    when: RenameParty(party, label)
    ensures:
        if party.label not in party.alternate_labels:
            party.alternate_labels =
                party.alternate_labels.append(party.label)
        party.label = label

    @guarantee PartyIdentitySurvivesRename
        -- Typed annotations and relationships retain the opaque Party ID.
        -- Labels may collide and never become global aliases.
}

rule AlternatePartyLabelAdded {
    when: AddAlternatePartyLabel(party, label)
    requires: label != party.label
    requires: label not in party.alternate_labels
    ensures:
        party.alternate_labels =
            party.alternate_labels.append(label)
}

rule PersonalBehaviorVersionPublished {
    when: PublishPersonalBehavior(
        id,
        namespace,
        version,
        focus_unit,
        lifetime,
        owns_entries,
        renders_all_open_entries,
        empty_is_dormant,
        phase,
        effort,
        repetition)
    requires: personal_namespace(namespace)
    requires: version = next_behavior_version(id, namespace)
    requires: behavior_configuration_valid(
        focus_unit,
        lifetime,
        owns_entries,
        renders_all_open_entries,
        empty_is_dormant,
        phase,
        effort,
        repetition)
    requires: not exists BrickBehavior{
        focus_unit,
        lifetime,
        owns_entries,
        renders_all_open_entries,
        empty_is_dormant,
        phase,
        effort,
        repetition
    }
    ensures: BrickBehavior.created(
        id: id,
        namespace: namespace,
        version: version,
        focus_unit: focus_unit,
        lifetime: lifetime,
        owns_entries: owns_entries,
        renders_all_open_entries: renders_all_open_entries,
        empty_is_dormant: empty_is_dormant,
        phase: phase,
        effort: effort,
        repetition: repetition)

    @guarantee ClosedCapabilitiesOnly
        -- Personal composition chooses only fields already understood by the
        -- core. New capability kinds require a core language version.
}

rule EquivalentBehaviorReused {
    when: PublishPersonalBehavior(
        id,
        namespace,
        version,
        focus_unit,
        lifetime,
        owns_entries,
        renders_all_open_entries,
        empty_is_dormant,
        phase,
        effort,
        repetition)
    let existing = equivalent_behavior(
        focus_unit,
        lifetime,
        owns_entries,
        renders_all_open_entries,
        empty_is_dormant,
        phase,
        effort,
        repetition)
    requires: exists existing
    ensures: ExistingBehaviorSelected(behavior: existing)

    @guarantee CapabilityIdentityIsReused
        -- The custom builder does not create a second behavior with an
        -- identical resolved capability tuple.
}

rule PersonalTemplateVersionPublished {
    when: PublishPersonalTemplate(
        id,
        namespace,
        version,
        display_name,
        category,
        purpose,
        search_terms,
        behavior,
        default_title?,
        default_description?)
    requires: personal_namespace(namespace)
    requires: version = next_template_version(id, namespace)
    requires:
        default_title = null
        or canonical_english_text(default_title)
    ensures: BrickTemplate.created(
        id: id,
        namespace: namespace,
        version: version,
        display_name: display_name,
        category: category,
        purpose: purpose,
        search_terms: search_terms,
        behavior: behavior,
        default_title: default_title,
        default_description: default_description)

    @guarantee TemplateIsOneTimeRecipe
        -- Instantiation copies the selected version's explicit defaults.
        -- Later template versions never change existing Bricks.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OpaqueEntityIdentity {
    for brick in Bricks:
        brick.id != brick.title
    for party in Parties:
        party.id != party.label
}

invariant CanonicalWorkTitlesAreEnglish {
    for brick in Bricks:
        canonical_english_text(brick.title)
    for entry in ListEntries:
        canonical_english_text(entry.label)
}

invariant NoSelfParent {
    for brick in Bricks:
        brick.parent = null or brick.parent != brick
}

invariant OneFocusRegister {
    for first in FocusRegisters:
        for second in FocusRegisters:
            first = second
}

invariant BehaviorVersionIdentityIsUnique {
    for first in BrickBehaviors:
        for second in BrickBehaviors:
            (
                first.id = second.id
                and first.namespace = second.namespace
                and first.version = second.version
            ) implies first = second
}

invariant TemplateVersionIdentityIsUnique {
    for first in BrickTemplates:
        for second in BrickTemplates:
            (
                first.id = second.id
                and first.namespace = second.namespace
                and first.version = second.version
            ) implies first = second
}

invariant EntryOwnerSupportsEntries {
    for entry in ListEntries:
        entry.owner.behavior.owns_entries = true
}

invariant TerminalBrickIsNotWip {
    for brick in Bricks:
        brick.status != active implies brick.work_state = idle
}

invariant PhaseRespectsBehavior {
    for brick in Bricks:
        brick.behavior.phase = disabled implies brick.phase = null
}

invariant EffectiveMetadataUsesNearestExplicitAncestor {
    for brick in Bricks:
        brick.context != null implies
            brick.effective_context = brick.context
    for brick in Bricks:
        brick.mode != null implies
            brick.effective_mode = brick.mode
}

invariant EffectiveDatesAccumulateConstraints {
    -- not_before uses the latest non-null value on self and ancestors;
    -- best_before and deadline use the earliest. Descendants cannot silently
    -- weaken an ancestor's temporal constraint.
    true
}

invariant DateRevisionIsNonNegative {
    for brick in Bricks:
        brick.date_revision >= 0
}

invariant DormancyFollowsBehaviorCapability {
    -- Collections, standing checklists, and recurring obligations are dormant
    -- when they own no active child or entry work. Practices additionally
    -- consult applicable open opportunities; an empty structural tree alone
    -- never hides an available practice opportunity.
    true
}

------------------------------------------------------------
-- Actor and surface
------------------------------------------------------------

actor User {
    identified_by: Party where party_type = person
}

surface DefinitionLibrary {
    facing user: User

    exposes:
        user.id

    provides:
        CreateParty(label, party_type)
        RenameParty(party, label)
        AddAlternatePartyLabel(party, label)
        PublishPersonalBehavior(
            id,
            namespace,
            version,
            focus_unit,
            lifetime,
            owns_entries,
            renders_all_open_entries,
            empty_is_dormant,
            phase,
            effort,
            repetition)
        PublishPersonalTemplate(
            id,
            namespace,
            version,
            display_name,
            category,
            purpose,
            search_terms,
            behavior,
            default_title?,
            default_description?)

    contracts:
        fulfils DefinitionCatalog
}

