-- allium: 3
-- Little Ant 1.0 — human priority, impact, effort, and scope evidence.

use "./domain.allium" as domain

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum PrioritySkipKind { unresolved | tie_break_for_me }
enum InsertionStatus { open | resolved | deferred }
enum RecalibrationStatus { open | resolved }
enum JudgmentAxis { priority | impact | effort }
enum ProbePurpose { discovery | validation | recalibration }
enum JudgmentProbeStatus { open | deferred | resolved }
enum ImpactClass {
    `VERY_LOW` |
    `LOW` |
    `MEDIUM` |
    `HIGH` |
    `VERY_HIGH` |
    `CRITICAL`
}
enum ImpactMaturity {
    `SPECULATIVE` |
    `SUPPORTED` |
    `VALIDATED` |
    `OBSERVED`
}
enum RelativeAssessment { less | similar | more }
enum EffortComparison {
    much_less |
    a_little_less |
    similar |
    a_little_more |
    much_more
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity PriorityScope {
    id: String
    parent: domain/Brick?
    members: List<domain/Brick>
    revision: Integer

    view: PriorityView = priority_view(this)
}

entity PriorityInsertion {
    id: String
    brick: domain/Brick
    scope: PriorityScope
    status: InsertionStatus
    current_candidate: domain/Brick?
    comparisons_recorded: Integer
    consecutive_skips: Integer
    random_evidence: String
    started_at: Timestamp
    finished_at: Timestamp?

    transitions status {
        open -> resolved
        open -> deferred
        deferred -> open
        deferred -> resolved
        terminal: resolved
    }
}

entity PriorityJudgment {
    id: String
    scope: PriorityScope
    scope_revision: Integer
    more_important: domain/Brick
    less_important: domain/Brick
    authority: domain/Authority
    recorded_at: Timestamp
    reason: String?
    applicable: Boolean

    is_current: Boolean =
        applicable and current_priority_judgment(
            scope,
            unordered_pair(more_important, less_important)
        ) = this
    evidence_view: PriorityEvidenceView =
        priority_evidence(scope, more_important, less_important)
}

entity PriorityComparisonSkip {
    id: String
    insertion: PriorityInsertion
    candidate: domain/Brick
    kind: PrioritySkipKind
    recorded_at: Timestamp
}

entity PriorityRecalibration {
    id: String
    scope: PriorityScope
    segment: List<domain/Brick>
    proposed_order: List<domain/Brick>
    status: RecalibrationStatus
    created_at: Timestamp
    resolved_at: Timestamp when status = resolved

    transitions status {
        open -> resolved
        terminal: resolved
    }
}

entity ImpactAssessment {
    id: String
    root: domain/Brick
    impact: ImpactClass
    maturity: ImpactMaturity
    authority: domain/Authority
    reason: String?
    recorded_at: Timestamp
    applicable: Boolean

    is_current: Boolean =
        applicable and current_impact_assessment(root) = this
    evidence_view: ImpactEvidenceView = impact_evidence(root)
}

entity ImpactComparison {
    id: String
    left: domain/Brick
    right: domain/Brick
    result: RelativeAssessment
    authority: domain/Authority
    reason: String?
    recorded_at: Timestamp
    applicable: Boolean

    is_current: Boolean =
        applicable and current_impact_comparison(
            unordered_pair(left, right)
        ) = this
}

entity EffortProfile {
    id: String
    version: Integer
    name: String
}

entity EffortBand {
    id: String
    profile: EffortProfile
    ordinal: Integer
    macro: String
    optimistic_hours: Decimal
    realistic_hours: Decimal
    pessimistic_hours: Decimal
}

entity EffortAssessment {
    id: String
    brick: domain/Brick
    band: EffortBand
    authority: domain/Authority
    provisional: Boolean
    reason: String?
    recorded_at: Timestamp
    applicable: Boolean

    is_current: Boolean =
        applicable and current_effort_assessment(brick) = this
    evidence_view: EffortEvidenceView = effort_evidence(brick)
    remaining_view: RemainingEffortProjection =
        remaining_effort_projection(brick, band.profile)
}

entity EffortComparisonEvidence {
    id: String
    subject: domain/Brick
    exemplar: domain/Brick
    result: EffortComparison
    authority: domain/Authority
    recorded_at: Timestamp
    applicable: Boolean

    is_current: Boolean =
        applicable and current_effort_comparison(
            unordered_pair(subject, exemplar)
        ) = this
}

entity ScopeRevision {
    id: String
    brick: domain/Brick
    reason: String
    authority: domain/Authority
    confirmed_at: Timestamp
}

entity JudgmentProbe {
    id: String
    axis: JudgmentAxis
    purpose: ProbePurpose
    scope: PriorityScope?
    left: domain/Brick
    right: domain/Brick
    reason: String
    status: JudgmentProbeStatus
    created_at: Timestamp
    resolved_at: Timestamp?

    transitions status {
        open -> deferred
        open -> resolved
        deferred -> open
        deferred -> resolved
        terminal: resolved
    }
}

------------------------------------------------------------
-- Derived evidence views and contract
------------------------------------------------------------

value PriorityEvidenceView {
    scope: PriorityScope
    left: domain/Brick
    right: domain/Brick
    current_more_important: domain/Brick?
    confidence: Decimal
    confidence_reasons: List<String>
    provisional: Boolean
}

value PriorityViewItem {
    brick: domain/Brick
    scope: PriorityScope
    sibling_index: Integer
    tree_path: List<Integer>
    confidence: Decimal
    confidence_reasons: List<String>
    provisional: Boolean
}

value PriorityView {
    root_scope: PriorityScope
    revision_fingerprint: String
    items: List<PriorityViewItem>
}

value ImpactEvidenceView {
    root: domain/Brick
    current: ImpactAssessment?
    reliability_reasons: List<String>
    needs_validation: Boolean
}

value EffortEvidenceView {
    brick: domain/Brick
    current: EffortAssessment?
    confidence_reasons: List<String>
    needs_validation: Boolean
}

value RemainingEffortProjection {
    brick: domain/Brick
    effort_profile: EffortProfile
    total_band: EffortBand?
    optimistic_hours: Decimal?
    realistic_hours: Decimal?
    pessimistic_hours: Decimal?
    evidence: List<String>
    confidence_reasons: List<String>
}

contract JudgmentDerivation {
    priority: (
        scope: PriorityScope,
        left: domain/Brick,
        right: domain/Brick
    ) -> PriorityEvidenceView
    impact: (root: domain/Brick) -> ImpactEvidenceView
    effort: (brick: domain/Brick) -> EffortEvidenceView
    remaining_effort: (
        brick: domain/Brick,
        profile: EffortProfile
    ) -> RemainingEffortProjection

    @invariant FullHistoryIsRetained
        -- A newer judgment changes the derived current view; it never
        -- overwrites or deletes older evidence.

    @invariant HumanAuthorityPrecedesAi
        -- Applicable human evidence cannot be silently replaced by AI
        -- evidence. Conflicting AI evidence may lower confidence and request
        -- validation.

    @invariant NewerApplicableEvidenceWeighsMore
        -- Within the same authority tier and applicable scope, more recent
        -- evidence contributes more than older evidence.

    @invariant ContradictionLowersConfidence
        -- Reversals, cycles, and inconsistent direct or transitive evidence
        -- remain valid history while lowering confidence or reliability.

    @invariant ProgressNeverRewritesTotalEffort
        -- Total effort remains the current scope assessment. Remaining effort
        -- is a planning-only projection derived conservatively from completed
        -- descendants, explicit human progress, or imported actuals; focus
        -- duration alone is never completion evidence.
}

contract PriorityProjection {
    build: (root_scope: PriorityScope) -> PriorityView

    @invariant LocalOrderIsExact
        -- Within each scope, the projection preserves members exactly and
        -- assigns sibling indexes from their strict human importance order.

    @invariant GlobalOrderIsLexicographicTreePath
        -- A global priority view sorts active Bricks lexicographically by the
        -- sequence of sibling indexes from the root to the Brick.

    @invariant ConfidenceIsExplanatoryNotSorting
        -- Confidence and its reasons are displayed metadata. Phase, impact,
        -- effort, dates, dependency, and confidence never silently rewrite or
        -- substitute the human priority path.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    priority_nearby_distance: Integer = 3
    priority_skip_limit: Integer = 2
    effort_assistance_limit: Integer = 3
}

------------------------------------------------------------
