------------------------------------------------------------

default PriorityScope root_priority = {
    id: "core/root-priority",
    members: [],
    revision: 0
}

default EffortProfile initial_effort_profile = {
    id: "core/effort",
    version: 1,
    name: "Little Ant default effort profile"
}

default EffortBand effort_very_easy = {
