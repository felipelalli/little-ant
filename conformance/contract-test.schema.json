{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://little-ant.dev/schemas/contract-test-v1.json",
  "title": "Little Ant contract-test descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "rules",
    "screens",
    "flow",
    "kind",
    "spec_hashes",
    "obligations"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "rules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "screens": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "flow": { "type": ["string", "null"] },
    "kind": {
      "enum": ["unit", "property", "state-machine", "protocol", "golden", "e2e"]
    },
    "spec_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "obligations": {
      "type": "array",
      "items": { "enum": ["negative", "gate", "boundary"] },
      "uniqueItems": true
    }
  }
}
