cabal-version:      3.0
name:               little-ant
version:            1.0.0.0
synopsis:           A personal focus engine, one Brick at a time
description:
  Little Ant is a deterministic personal focus engine. This package is the
  greenfield implementation of the canonical Little Ant 1.0 contract.

license:            BSD-3-Clause
license-file:       LICENSE
author:             Felipe Micaroni Lalli
maintainer:         la@nok.uy
homepage:           https://github.com/felipelalli/little-ant
category:           Productivity
build-type:         Simple
extra-doc-files:
  CHANGELOG.md
  README.md

data-files:         packs/standard/standard.lantpack
extra-source-files:
  conformance/*.json
  conformance/*.tsv
  implementation/*.md
  implementation/coverage.tsv
  implementation/slices/*.md
  packs/official-connectors/official-connectors.lantpack
  packs/official-connectors/pack.json
  packs/official-connectors/payload/sources/**/*.json
  packs/official-connectors/payload/sources/**/*.lua
  packs/official-connectors/payload/sources/**/*.md
  packs/official-connectors/signature.json
  packs/standard/pack.json
  packs/standard/payload/exporters/**/*.json
  packs/standard/payload/exporters/**/*.lua
  packs/standard/payload/exporters/**/*.md
  packs/standard/payload/sources/**/*.json
  packs/standard/payload/sources/**/*.lua
  packs/standard/payload/sources/**/*.md
  packs/standard/signature.json
  spec/little-ant-1.0/*.md
  spec/little-ant-1.0/ux/*.md
  spec/little-ant-1.0.md
  test/fixtures/standard-pack/*.html
  test/fixtures/standard-pack/*.json
  test/fixtures/standard-pack/*.org
  test/fixtures/standard-pack/*.txt
  tools/rebuild-official-connectors-pack.hs
  tools/rebuild-standard-pack.hs

source-repository head
  type:     git
  location: https://github.com/felipelalli/little-ant

common language
  default-language:   GHC2021
  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    StrictData

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints

library
  import:          language, warnings
  autogen-modules: Paths_little_ant
  other-modules:   Paths_little_ant
  exposed-modules:
    LittleAnt.Application
    LittleAnt.Catalog
    LittleAnt.Conformance
    LittleAnt.Decision
    LittleAnt.Error
    LittleAnt.Event
    LittleAnt.Export
    LittleAnt.Forecast
    LittleAnt.ForecastWorld
    LittleAnt.Foundation
    LittleAnt.Id
    LittleAnt.Import
    LittleAnt.Interaction
    LittleAnt.Judgment
    LittleAnt.JudgmentDecision
    LittleAnt.JudgmentUI
    LittleAnt.Model
    LittleAnt.Notice
    LittleAnt.OAuth.Device
    LittleAnt.Pack.Admin
    LittleAnt.Pack.Catalog
    LittleAnt.Pack.Format
    LittleAnt.Pack.Http
    LittleAnt.Pack.Installed
    LittleAnt.Pack.Registry
    LittleAnt.Pack.Runner
    LittleAnt.Pack.Standard
    LittleAnt.Pack.Store
    LittleAnt.Pack.Transport
    LittleAnt.Pack.Trust
    LittleAnt.Planning
    LittleAnt.Profile
    LittleAnt.Projection
    LittleAnt.Protocol
    LittleAnt.Provider
    LittleAnt.Reference
    LittleAnt.Repair
    LittleAnt.REPL
    LittleAnt.Result
    LittleAnt.Schedule
    LittleAnt.Source
    LittleAnt.Store
    LittleAnt.Surface
    LittleAnt.TaskJugglerActuals
    LittleAnt.Temporal
    LittleAnt.Terminal
    LittleAnt.Time
    LittleAnt.Vault
    LittleAnt.Vault.Age
    LittleAnt.Vault.Agent

  hs-source-dirs:  src
  build-depends:
    , aeson               >=2.2   && <2.3
    , base                >=4.20  && <5
    , base16-bytestring   >=1.0   && <1.1
    , base64-bytestring   >=1.2   && <1.3
    , binary              >=0.8   && <0.9
    , bytestring          >=0.12  && <0.13
    , case-insensitive    >=1.2   && <1.3
    , containers          >=0.7   && <0.8
    , cryptohash-sha256   >=0.11  && <0.12
    , crypton             >=1.0   && <1.1
    , digest              >=0.0.2 && <0.1
    , directory           >=1.3   && <1.4
    , entropy             >=0.4   && <0.5
    , filelock            >=0.1   && <0.2
    , filepath            >=1.5   && <1.6
    , hslua               >=2.3   && <2.4
    , http-client         >=0.7   && <0.8
    , http-client-tls     >=0.3   && <0.4
    , http-types          >=0.12  && <0.13
    , memory              >=0.18  && <0.19
    , network             >=3.2   && <3.3
    , network-uri         >=2.6   && <2.7
    , process             >=1.6   && <1.7
    , scientific          >=0.3   && <0.4
    , text                >=2.1   && <2.2
    , time                >=1.12  && <1.13
    , tz                  >=0.1.3 && <0.2
    , unicode-transforms  >=0.4   && <0.5
    , unix                >=2.8   && <2.9
    , vty                 >=6.4   && <6.5
    , vty-crossplatform   >=0.4   && <0.5
    , yaml                >=0.11  && <0.12
    , zip-archive         >=0.4.3 && <0.5

  extra-libraries:
    lant_age_ffi
    pthread
    dl
    m

executable lant
  import:         language, warnings
  main-is:        Main.hs
  hs-source-dirs: app
  ghc-options:    -threaded
  build-depends:
    , aeson                 >=2.2  && <2.3
    , base                  >=4.20 && <5
    , bytestring            >=0.12 && <0.13
    , containers            >=0.7  && <0.8
    , directory             >=1.3  && <1.4
    , filepath              >=1.5  && <1.6
    , little-ant
    , optparse-applicative  >=0.18 && <0.19
    , process               >=1.6  && <1.7
    , text                  >=2.1  && <2.2
    , unix                  >=2.8  && <2.9

executable lant-pack-runner
  import:         language, warnings
  main-is:        PackRunnerMain.hs
  hs-source-dirs: app
  ghc-options:    -rtsopts
  build-depends:
    , base        >=4.20 && <5
    , little-ant

